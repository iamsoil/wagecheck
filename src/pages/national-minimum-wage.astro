      }
    },
    {
      "@type": "Question",
      "name": "What age do you get National Living Wage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You are entitled to the National Living Wage from age 21 and over. Workers aged 18-20 receive the lower NMW rate of £10.85 per hour."
