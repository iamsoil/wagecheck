  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the minimum wage in 2026 UK?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "From April 2026, the UK minimum wage is £12.71 per hour for workers aged 21 and over (National Living Wage), £10.85 per hour for 18-20 year olds, and £8.00 per hour for under 18s and apprentices."
      }
    },
    {
      "@type": "Question",
      "name": "What is the National Living Wage 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The National Living Wage 2026 is £12.71 per hour for workers aged 21 and over. This is the highest tier of the UK minimum wage system and is a legal requirement for employers."
      }
    },
    {
      "@type": "Question",
      "name": "How much is minimum wage per month?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "At 37.5 hours per week, the minimum wage monthly pay is approximately £1,780 (21+), £1,563 (18-20), or £1,229 (under 18/apprentice) before tax."
      }
    },
    {
      "@type": "Question",
      "name": "Does minimum wage include tax?",
      "acceptedAnswer": {
