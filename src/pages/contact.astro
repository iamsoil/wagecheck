---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact | wagecheck"
  description="Get in touch with wagecheck. We're happy to help with calculator feedback, bug reports or general enquiries."
>
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">Contact</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Get in <span class="font-display italic text-emerald-600">Touch</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Questions, feedback or bug reports — we'd love to hear from you.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_380px]">
      <div class="rounded-2xl border border-slate-100 bg-white p-8 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900">Send us a message</h2>
        <p class="mt-1 text-sm text-slate-500">Fields marked with * are required.</p>

        <form id="contact-form" class="mt-6 space-y-5" novalidate>
          <div>
            <label for="contact-name" class="mb-1.5 block text-sm font-semibold text-slate-700">Full Name *</label>
            <input type="text" id="contact-name" name="name" required placeholder="e.g. John Smith" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100" />
          </div>
          <div>
            <label for="contact-email" class="mb-1.5 block text-sm font-semibold text-slate-700">Email Address *</label>
            <input type="email" id="contact-email" name="email" required placeholder="john@example.com" class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100" />
          </div>
          <div>
            <label for="contact-topic" class="mb-1.5 block text-sm font-semibold text-slate-700">Topic *</label>
            <select id="contact-topic" name="topic" required class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100">
              <option value="" disabled selected>— Select a Topic —</option>
              <option value="general">General Enquiry</option>
              <option value="calculation">Calculation Question</option>
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="privacy">Privacy / Data Question</option>
              <option value="advertising">Advertising / Partnerships</option>
            </select>
          </div>
          <div>
            <label for="contact-message" class="mb-1.5 block text-sm font-semibold text-slate-700">Message *</label>
            <textarea id="contact-message" name="message" required rows="5" placeholder="Describe your query in detail. If reporting a calculation issue, include the gross salary, tax code, and pension rate you used." class="w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100"></textarea>
          </div>
          <label class="flex items-start gap-2 text-sm text-slate-600">
            <input type="checkbox" id="contact-confirm" required class="mt-0.5 h-4 w-4 rounded border-slate-300 accent-emerald-600" />
            <span>I confirm I have not included sensitive details such as NI numbers, bank details, payslips or passwords in this message. *</span>
          </label>
          <button type="submit" class="w-full rounded-xl bg-emerald-600 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700">
            Send Message
          </button>
        </form>

        <div id="contact-success" class="hidden rounded-2xl border border-emerald-200 bg-emerald-50 p-6 text-center">
          <svg class="mx-auto h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          <p class="mt-3 text-base font-semibold text-slate-900">Message sent</p>
          <p class="mt-1 text-sm text-slate-600">We typically respond within 24 hours.</p>
        </div>
      </div>

      <div class="space-y-6">
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
            <div>
              <p class="text-sm font-semibold text-amber-900">Security Notice</p>
              <p class="mt-2 text-sm leading-6 text-amber-800">Wagecheck will never ask for your HMRC login, NI number, bank details, or full payslips. Do not include any sensitive personal data in your message.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900">Support Info</h3>
          <div class="mt-4 space-y-3">
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
              <p class="text-sm text-slate-600">Response time: Within 24–48 business hours</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
              <p class="text-sm text-slate-600">Office hours: Mon–Fri, 9 AM – 5 PM GMT</p>
            </div>
            <div class="flex items-start gap-3">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
              <p class="text-sm text-slate-600">Calculation queries: Include your gross pay, tax code, and pension rate so we can replicate the result.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900">Helpful Links</h3>
          <ul class="mt-4 space-y-2.5">
            <li><a href="/salary-calculator" class="text-sm text-emerald-600 transition hover:text-emerald-700">Main Salary Calculator</a></li>
            <li><a href="/compare-salaries" class="text-sm text-emerald-600 transition hover:text-emerald-700">Compare Two Salaries</a></li>
            <li><a href="/pro-rata-calculator" class="text-sm text-emerald-600 transition hover:text-emerald-700">Pro-Rata Calculator</a></li>
            <li><a href="/stamp-duty" class="text-sm text-emerald-600 transition hover:text-emerald-700">Stamp Duty Guide</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-l-4 border-amber-400 bg-amber-50 p-6">
      <div class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
        <div>
          <p class="text-sm font-semibold text-amber-900">Financial &amp; Tax Guidance Disclaimer</p>
          <p class="mt-2 text-sm leading-6 text-amber-800">Wagecheck provides estimated take-home pay and tax deductions based on standard UK tax codes (e.g., 1257L) and HMRC allowances for the 2026/27 tax year. This tool is designed for general guidance only and does not constitute professional financial, legal, or tax advice. Always consult a certified accountant or HMRC directly for your specific tax affairs.</p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form');
    const success = document.getElementById('contact-success');
    if (form && success) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
        const topic = (document.getElementById('contact-topic') as HTMLSelectElement)?.value;
        const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();
        const confirm = (document.getElementById('contact-confirm') as HTMLInputElement)?.checked;
        if (!name || !email || !topic || !message || !confirm) return;
        form.classList.add('hidden');
        success.classList.remove('hidden');
      });
    }
  </script>
</Layout>
