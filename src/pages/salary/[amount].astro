---
import Layout from '../../layouts/Layout.astro';
import OdometerNumber from '../../components/OdometerNumber.astro';
import TakeHomeCalculator from '../../components/TakeHomeCalculator.astro';
import { calculateTakeHomePay } from '../../lib/calculations';

export async function getStaticPaths() {
  const amounts = [];

  for (let amount = 15000; amount <= 100000; amount += 1000) {
    const calculation = calculateTakeHomePay({
      grossAnnualSalary: amount,
      pensionContributionPercent: 5,
      studentLoanPlan: 'plan2',
    });

    amounts.push({
      params: { amount: amount.toString() },
      props: { amount, calculation },
    });
  }

  return amounts;
}

const { amount, calculation } = Astro.props as {
  amount: number;
  calculation: ReturnType<typeof calculateTakeHomePay>;
};

const currencyFormatter = new Intl.NumberFormat('en-GB', {
  style: 'currency',
  currency: 'GBP',
  maximumFractionDigits: 0,
});

const percentFormatter = new Intl.NumberFormat('en-GB', {
  maximumFractionDigits: 1,
});

function formatCurrency(value: number) {
  return currencyFormatter.format(Math.round(value));
}

function formatPercent(value: number) {
  return `${percentFormatter.format(value)}%`;
}

const lowerAmount = amount - 1000;
const upperAmount = amount + 1000;
const stampDutyPrice = amount * 3;
const effectiveTaxRate = amount > 0 ? (calculation.incomeTax / amount) * 100 : 0;
const monthlyNetPercent = amount > 0 ? (calculation.monthlyTakeHome * 12 / amount) * 100 : 0;
---

<Layout
  title={`£${amount.toLocaleString('en-GB')} After Tax 2026/27 | Wagecheck`}
  description={`Calculate your take-home pay on £${amount.toLocaleString('en-GB')} for 2026/27. Includes income tax, National Insurance, student loans and pension contributions.`}
>
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">Salary SEO page</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">£{amount.toLocaleString('en-GB')} After Tax in 2026/27</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Compare take-home pay, income tax, National Insurance, student loan repayments and pension deductions for this salary level.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#f8fafc]">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Annual take-home</p>
          <OdometerNumber value={calculation.annualTakeHome} duration={1200} class="mt-3 text-4xl font-bold text-emerald-600" />
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Monthly take-home</p>
          <OdometerNumber value={calculation.monthlyTakeHome} duration={1200} class="mt-3 text-3xl font-bold text-slate-900" />
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Tax paid</p>
          <OdometerNumber value={calculation.incomeTax} duration={800} class="mt-3 text-3xl font-bold text-slate-900" />
          <p class="mt-1 text-sm text-slate-500">{formatPercent(effectiveTaxRate)} of gross</p>
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">NI paid</p>
          <OdometerNumber value={calculation.nationalInsurance} duration={800} class="mt-3 text-3xl font-bold text-slate-900" />
          <p class="mt-1 text-sm text-slate-500">{formatPercent(amount > 0 ? (calculation.nationalInsurance / amount) * 100 : 0)} of gross</p>
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Student loan</p>
          <OdometerNumber value={calculation.studentLoan} duration={800} class="mt-3 text-3xl font-bold text-slate-900" />
          <p class="mt-1 text-sm text-slate-500">Plan 2 default</p>
        </article>
      </div>

      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="text-sm font-medium text-slate-500">Pension deduction</p>
            <OdometerNumber value={calculation.pension} duration={800} class="mt-2 text-2xl font-bold text-slate-900" />
            <p class="mt-1 text-sm text-slate-500">5% of gross</p>
          </div>
          <div>
            <p class="text-sm font-medium text-slate-500">Personal allowance</p>
            <OdometerNumber value={calculation.personalAllowance} duration={800} class="mt-2 text-2xl font-bold text-slate-900" />
          </div>
          <div>
            <p class="text-sm font-medium text-slate-500">Taxable income</p>
            <OdometerNumber value={calculation.taxableIncome} duration={800} class="mt-2 text-2xl font-bold text-slate-900" />
          </div>
          <div>
            <p class="text-sm font-medium text-slate-500">Take-home share</p>
            <OdometerNumber value={monthlyNetPercent} prefix="" duration={800} class="mt-2 text-2xl font-bold text-slate-900" />
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Related links</h2>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={`/salary/${lowerAmount}`} class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-700">
            Compare: £{lowerAmount.toLocaleString('en-GB')} after tax
          </a>
          <a href={`/salary/${upperAmount}`} class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-700">
            Compare: £{upperAmount.toLocaleString('en-GB')} after tax
          </a>
          <a href={`/stamp-duty/${stampDutyPrice}`} class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-emerald-700">
            Stamp duty on a £{stampDutyPrice.toLocaleString('en-GB')} property
          </a>
        </div>
      </div>
    </div>
  </section>

  <TakeHomeCalculator
    initialGrossSalary={amount}
    initialPensionContribution={5}
    initialStudentLoanPlan="plan2"
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `£${amount.toLocaleString('en-GB')} After Tax 2026/27`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    description: `Calculate your take-home pay on £${amount.toLocaleString('en-GB')} for 2026/27. Includes income tax, National Insurance, student loans and pension contributions.`,
    url: `/salary/${amount}`,
  })} />
</Layout>
