---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About | wagecheck"
  description="About wagecheck — free, accurate UK salary and tax calculators built for everyday financial clarity."
>
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">About</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          About <span class="font-display italic text-emerald-600">Wagecheck</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Free, accurate UK salary and tax calculators — built for everyday financial clarity.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100">
          <svg class="h-5 w-5 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 0 0 1.5-.189m-1.5.189a6.01 6.01 0 0 1-1.5-.189m3.75 7.478a12.06 12.06 0 0 1-4.5 0m3.75 2.383a14.406 14.406 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
        </div>
        <h2 class="mt-4 text-lg font-bold text-slate-900">Our Mission</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">To demystify UK take-home pay, tax, and property costs with fast, transparent, and free calculators.</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100">
          <svg class="h-5 w-5 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        </div>
        <h2 class="mt-4 text-lg font-bold text-slate-900">Our Approach</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">All calculations run instantly in your browser. No sign-ups, no data storage, no hidden agendas.</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100">
          <svg class="h-5 w-5 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
        </div>
        <h2 class="mt-4 text-lg font-bold text-slate-900">Who It's For</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Employees, freelancers, employers, landlords, and anyone navigating UK tax and payroll.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">What We Cover</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659 1.236-2.02c.622-.462 1.29-.76 2.005-.967A6 6 0 1 1 12 6Z" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">Salary &amp; Take-Home Pay</p>
            <p class="mt-1 text-xs text-slate-500">Full breakdown after tax, NI, pension</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">Hourly &amp; Pro-Rata Rates</p>
            <p class="mt-1 text-xs text-slate-500">Convert between hourly, salary, part-time</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 0H21" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">Stamp Duty (SDLT)</p>
            <p class="mt-1 text-xs text-slate-500">Property tax for England, Wales, Scotland</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">Rental Yield</p>
            <p class="mt-1 text-xs text-slate-500">Gross and net yield for buy-to-let</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">Salary Comparison &amp; Tables</p>
            <p class="mt-1 text-xs text-slate-500">Compare offers, view salary tables</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659 1.236-2.02c.622-.462 1.29-.76 2.005-.967A6 6 0 1 1 12 6Z" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">National Minimum Wage</p>
            <p class="mt-1 text-xs text-slate-500">Current NMW and NLW rates</p>
          </div>
        </div>
        <div class="flex items-start gap-3 rounded-xl border border-slate-100 p-4 sm:col-span-2">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 0 0 2.25 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0 0 12 2.25Z" /></svg>
          <div>
            <p class="text-sm font-semibold text-slate-900">Required Salary Calculator</p>
            <p class="mt-1 text-xs text-slate-500">Work backwards from your desired take-home pay</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-l-4 border-emerald-500 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
        <div>
          <h2 class="text-lg font-bold text-slate-900">Data &amp; Privacy</h2>
          <div class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
            <p>We do not collect, store, or transmit your salary data.</p>
            <p>All calculations happen client-side in your browser.</p>
            <p>We use anonymized Google Analytics 4 to understand site usage. See our <a href="/privacy-policy" class="font-semibold text-emerald-600 hover:text-emerald-700">Privacy Policy</a> for details.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-l-4 border-amber-400 bg-amber-50 p-6 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
        <div>
          <h2 class="text-lg font-bold text-amber-900">Financial &amp; Tax Guidance Disclaimer</h2>
          <div class="mt-3 space-y-2 text-sm leading-6 text-amber-800">
            <p>Estimates based on 2026/27 HMRC guidance. Rates may change at any time.</p>
            <p>Not a substitute for professional financial, legal, or tax advice.</p>
            <p>Always consult a certified accountant or HMRC directly for your specific tax affairs.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-100 bg-white p-5 text-center shadow-sm">
        <p class="text-2xl font-bold text-emerald-600">2026/27</p>
        <p class="mt-1 text-sm font-medium text-slate-600">Tax Year Rates</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-5 text-center shadow-sm">
        <p class="text-2xl font-bold text-emerald-600">HMRC</p>
        <p class="mt-1 text-sm font-medium text-slate-600">Verified Against Guidance</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-5 text-center shadow-sm">
        <p class="text-2xl font-bold text-emerald-600">100%</p>
        <p class="mt-1 text-sm font-medium text-slate-600">Free Forever — No Paywalls</p>
      </div>
    </div>
  </section>
</Layout>
