---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | wagecheck" description="About wagecheck and how the calculator estimates work.">
  <section class="bg-[#f8fafc]">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600">About</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900">Built for fast, reliable estimates</h1>
        <p class="mt-4 text-base leading-7 text-slate-600">
          wagecheck is a clean, focused UK calculator site for salary and property-related estimates.
        </p>
      </div>
    </div>
  </section>
</Layout>