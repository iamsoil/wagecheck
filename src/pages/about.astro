---
import Layout from '../layouts/Layout.astro';
import {
  Target,
  Shield,
  Landmark,
  Zap,
  MessageCircle,
  Users,
  Search,
  Briefcase,
  Building2,
  GraduationCap,
  Home,
  CheckCircle,
  Calendar,
  BadgeCheck,
  ArrowRight,
  Coins,
  Clock,
  CalendarDays,
  PoundSterling,
  TrendingUp,
  Calculator,
  FileText,
  BarChart3,
  BadgeDollarSign,
  ArrowLeftRight,
  Table2,
  CircleCheck,
  BarChart2,
  MapPin,
  Heart,
  BriefcaseBusiness,
} from 'lucide-static';

function icon(svg: string, cls: string): string {
  return svg.replace('<svg', `<svg class="${cls}"`);
}
---

<Layout
  title="About | wagecheck"
  description="About wagecheck — free, accurate UK salary and tax calculators built for everyday financial clarity."
>
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-24 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">About</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          About <span class="font-display italic text-emerald-600">Wagecheck</span>
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          Free, accurate UK salary and tax calculators — built for everyday financial clarity.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 1: OUR MISSION -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Our Mission</h2>
          <p class="mt-6 text-base leading-7 text-slate-600">
            We built Wagecheck because understanding your take-home pay should not require a degree in accounting. Too many UK workers accept job offers, plan mortgages and budget around rough guesses because accurate take-home pay tools are either paywalled or buried behind sign-ups. We wanted a single place where anyone can enter their salary and instantly see the real number — after income tax, National Insurance, pension and student loan. Every calculator is free, always. We update every April when HMRC publishes new rates, so you never work with outdated figures. Our goal is financial clarity for everyone, regardless of income.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-1.5 text-sm font-medium text-emerald-700">
              <Fragment set:html={icon(Coins, 'h-4 w-4')} />
              17 Calculators
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-1.5 text-sm font-medium text-emerald-700">
              <Fragment set:html={icon(Calendar, 'h-4 w-4')} />
              2026/27 Rates
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-4 py-1.5 text-sm font-medium text-emerald-700">
              <Fragment set:html={icon(BadgeCheck, 'h-4 w-4')} />
              100% Free
            </span>
          </div>
        </div>
        <div class="flex items-center justify-center">
          <div class="flex h-32 w-32 items-center justify-center rounded-full bg-emerald-100">
            <Fragment set:html={icon(Target, 'h-16 w-16 text-emerald-600')} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: OUR APPROACH -->
  <section class="bg-emerald-50 py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Our Approach</h2>
        <p class="mt-6 text-base leading-7 text-slate-600">
          All calculations run instantly in your browser — your salary data never leaves your device. We do not collect, store or transmit any personal information. There are no sign-ups, no accounts and no hidden data harvesting. Every rate and threshold comes directly from HMRC, GOV.UK and the relevant devolved authorities. When rates change in April, we update our calculators within the first week of the new tax year. We also listen to community feedback: feature requests, corrections and suggestions directly shape what we build next. The result is a calculator suite that stays accurate, fast and genuinely useful.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100">
            <Fragment set:html={icon(Shield, 'h-6 w-6 text-emerald-600')} />
          </div>
          <h3 class="mt-4 text-sm font-semibold text-slate-900">Privacy First</h3>
          <p class="mt-1 text-xs text-slate-500">No data leaves your browser</p>
        </div>
        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100">
            <Fragment set:html={icon(Landmark, 'h-6 w-6 text-emerald-600')} />
          </div>
          <h3 class="mt-4 text-sm font-semibold text-slate-900">HMRC Aligned</h3>
          <p class="mt-1 text-xs text-slate-500">Rates from official sources</p>
        </div>
        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100">
            <Fragment set:html={icon(Zap, 'h-6 w-6 text-emerald-600')} />
          </div>
          <h3 class="mt-4 text-sm font-semibold text-slate-900">Real-Time Updates</h3>
          <p class="mt-1 text-xs text-slate-500">Updated within days of rate changes</p>
        </div>
        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100">
            <Fragment set:html={icon(MessageCircle, 'h-6 w-6 text-emerald-600')} />
          </div>
          <h3 class="mt-4 text-sm font-semibold text-slate-900">Community Driven</h3>
          <p class="mt-1 text-xs text-slate-500">Features shaped by user feedback</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: WHO IT'S FOR -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Who Wagecheck Is For</h2>
          <p class="mt-6 text-base leading-7 text-slate-600">
            Employees checking whether their payslip is correct. Job seekers comparing two offers side by side to see which leaves more in their pocket. Freelancers and self-employed workers working out their tax bill before self-assessment deadline. Employers doing quick headcount calculations for payroll planning. Students and graduates entering the workforce for the first time and trying to understand what their starter salary actually means month-to-month. Landlords assessing rental yield. Anyone in the UK who earns money and wants to know exactly where it goes.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <Fragment set:html={icon(Users, 'h-4 w-4 text-emerald-600')} />
            Employees
          </div>
          <div class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <Fragment set:html={icon(Search, 'h-4 w-4 text-emerald-600')} />
            Job Seekers
          </div>
          <div class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <Fragment set:html={icon(Briefcase, 'h-4 w-4 text-emerald-600')} />
            Freelancers
          </div>
          <div class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <Fragment set:html={icon(Building2, 'h-4 w-4 text-emerald-600')} />
            Employers
          </div>
          <div class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <Fragment set:html={icon(GraduationCap, 'h-4 w-4 text-emerald-600')} />
            Students & Graduates
          </div>
          <div class="flex items-center gap-2 rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-700">
            <Fragment set:html={icon(Home, 'h-4 w-4 text-emerald-600')} />
            Landlords
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 4: WHY TRUST WAGECHECK? -->
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50 py-16 text-center md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Why Trust Wagecheck?</h2>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-slate-600">
        Every calculation is aligned to HMRC-published rates and verified against GOV.UK guidance. We review and update all calculators every April when the new tax year begins, and correct any errors as soon as they are identified. Wagecheck is used by thousands of people every month for salary planning, job comparisons and self-assessment preparation. The tool is 100% free with no paywalls, no premium tier and no hidden costs.
      </p>
      <div class="mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-xl border border-emerald-100 bg-white p-6 shadow-sm">
          <Fragment set:html={icon(CheckCircle, 'mx-auto h-8 w-8 text-emerald-500')} />
          <p class="mt-3 text-sm font-semibold text-slate-900">HMRC-Verified Rates</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-white p-6 shadow-sm">
          <Fragment set:html={icon(CalendarDays, 'mx-auto h-8 w-8 text-emerald-500')} />
          <p class="mt-3 text-sm font-semibold text-slate-900">Updated Every April</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-white p-6 shadow-sm">
          <Fragment set:html={icon(Users, 'mx-auto h-8 w-8 text-emerald-500')} />
          <p class="mt-3 text-sm font-semibold text-slate-900">Used by Thousands Monthly</p>
        </div>
        <div class="rounded-xl border border-emerald-100 bg-white p-6 shadow-sm">
          <Fragment set:html={icon(BadgeCheck, 'mx-auto h-8 w-8 text-emerald-500')} />
          <p class="mt-3 text-sm font-semibold text-slate-900">100% Free Forever</p>
        </div>
      </div>
      <div class="mt-12">
        <a href="/salary-calculator/" class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700">
          Try the Salary Calculator
          <Fragment set:html={icon(ArrowRight, 'h-4 w-4')} />
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT WE COVER -->
  <section class="mx-auto max-w-7xl px-4 py-16 md:py-24 sm:px-6 lg:px-8">
    <h2 class="mb-8 text-3xl font-bold text-slate-900">What We Cover</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/salary-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Coins, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Salary &amp; Take-Home Pay</p>
        <p class="mt-1 text-sm text-slate-500">Full breakdown after tax, NI, pension and student loan</p>
      </a>
      <a href="/hourly-wage-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Clock, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Hourly Wage</p>
        <p class="mt-1 text-sm text-slate-500">Convert your hourly rate to annual, monthly and weekly salary</p>
      </a>
      <a href="/pro-rata-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(CalendarDays, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Pro-Rata Calculator</p>
        <p class="mt-1 text-sm text-slate-500">Part-time and irregular hours based on full-time equivalent</p>
      </a>
      <a href="/stamp-duty-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(PoundSterling, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Stamp Duty (SDLT)</p>
        <p class="mt-1 text-sm text-slate-500">Property tax for England, Northern Ireland and Scotland</p>
      </a>
      <a href="/bonus-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(TrendingUp, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Bonus Tax</p>
        <p class="mt-1 text-sm text-slate-500">See how much of your bonus you keep after tax and NI</p>
      </a>
      <a href="/pay-rise-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(TrendingUp, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Pay Rise</p>
        <p class="mt-1 text-sm text-slate-500">Compare your current and new salary side-by-side</p>
      </a>
      <a href="/overtime-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Clock, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Overtime Pay</p>
        <p class="mt-1 text-sm text-slate-500">Time and a half, double time — gross and net overtime pay</p>
      </a>
      <a href="/mortgage-affordability/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Home, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Mortgage Affordability</p>
        <p class="mt-1 text-sm text-slate-500">How much you can borrow and estimated monthly payments</p>
      </a>
      <a href="/required-salary/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Target, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Required Salary</p>
        <p class="mt-1 text-sm text-slate-500">Work backwards from your desired take-home pay</p>
      </a>
      <a href="/compare-salaries/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(ArrowLeftRight, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Compare Salaries</p>
        <p class="mt-1 text-sm text-slate-500">Side-by-side comparison of two job offers</p>
      </a>
      <a href="/salary-tables/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Table2, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Salary Tables</p>
        <p class="mt-1 text-sm text-slate-500">Tax bands, thresholds and reference tables</p>
      </a>
      <a href="/national-minimum-wage/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(CircleCheck, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">National Minimum Wage</p>
        <p class="mt-1 text-sm text-slate-500">Current NMW and NLW rates by age group</p>
      </a>
      <a href="/rental-yield/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(BarChart3, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Rental Yield</p>
        <p class="mt-1 text-sm text-slate-500">Gross and net yield for buy-to-let properties</p>
      </a>
      <a href="/scottish-salary-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(MapPin, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Scottish Salary Calculator</p>
        <p class="mt-1 text-sm text-slate-500">Calculate take-home pay using Scotland's 6-band income tax system</p>
      </a>
      <a href="/sick-pay-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(Heart, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Sick Pay Calculator</p>
        <p class="mt-1 text-sm text-slate-500">Calculate Statutory Sick Pay (SSP) under the new day-1 rules</p>
      </a>
      <a href="/self-employed-tax-calculator/" class="group rounded-2xl border border-slate-100 bg-white p-6 transition-all duration-200 hover:border-emerald-200 hover:shadow-sm">
        <Fragment set:html={icon(BriefcaseBusiness, 'h-5 w-5 shrink-0 text-emerald-600')} />
        <p class="mt-3 text-base font-semibold text-slate-900">Self-Employed Tax Calculator</p>
        <p class="mt-1 text-sm text-slate-500">Income tax, Class 2 and Class 4 NICs for sole traders and freelancers</p>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border-l-4 border-emerald-500 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <Fragment set:html={icon(Shield, 'mt-0.5 h-5 w-5 shrink-0 text-emerald-600')} />
        <div>
          <h2 class="text-lg font-bold text-slate-900">Data &amp; Privacy</h2>
          <div class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
            <p>We do not collect, store, or transmit your salary data.</p>
            <p>All calculations happen client-side in your browser.</p>
            <p>We use anonymized Google Analytics 4 to understand site usage. See our <a href="/privacy-policy/" class="font-semibold text-emerald-600 hover:text-emerald-700">Privacy Policy</a> for details.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Our Story</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Wagecheck was built because understanding your take-home pay should not require a degree in accounting. Too many UK workers rely on rough estimates or outdated assumptions when making financial decisions — from accepting a job offer to planning a mortgage. We wanted to create a tool that is fast, accurate and genuinely free. No sign-ups, no paywalls, no hidden agendas. Just honest calculators that give you the numbers you need to make confident decisions about your money.
        </p>
        <p class="mt-3 text-base leading-7 text-slate-600">
          The project started with a simple salary calculator and grew into a comprehensive suite of 17 tools covering income tax, National Insurance, stamp duty, self-employment, sick pay and more. Every calculator runs entirely in your browser — your salary data never leaves your device.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">How We Calculate</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Transparency is central to everything we do. Every calculation on Wagecheck uses the exact same rules published by HMRC, Revenue Scotland and the Welsh Revenue Authority. We apply the correct income tax bands, National Insurance thresholds, pension auto-enrolment rules and student loan repayment plans for the current tax year. Where a calculator makes assumptions — for example, a 5% pension contribution or a specific tax code — we state those assumptions clearly on the page.
        </p>
        <p class="mt-3 text-base leading-7 text-slate-600">
          We do not round figures to make them look cleaner. The numbers you see are the actual calculated values, rounded only to the nearest pound where appropriate. If your payslip shows a slightly different figure, it is usually because your employer uses a different pay frequency or applies employer-specific deductions that our general-purpose calculator cannot account for.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Data Sources</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          All tax rates and thresholds on Wagecheck come from official UK government sources:
        </p>
        <ul class="mt-3 list-disc space-y-2 pl-6 text-sm text-slate-600">
          <li><a href="https://www.gov.uk/income-tax-rates" target="_blank" rel="noopener" class="font-semibold text-emerald-600 hover:text-emerald-700">GOV.UK — Income Tax rates and allowances</a></li>
          <li><a href="https://www.gov.uk/national-insurance-rates-letters" target="_blank" rel="noopener" class="font-semibold text-emerald-600 hover:text-emerald-700">GOV.UK — National Insurance rates</a></li>
          <li><a href="https://www.gov.uk/stamp-duty-land-tax" target="_blank" rel="noopener" class="font-semibold text-emerald-600 hover:text-emerald-700">GOV.UK — Stamp Duty Land Tax</a></li>
          <li><a href="https://www.gov.uk/student-loan-repayment" target="_blank" rel="noopener" class="font-semibold text-emerald-600 hover:text-emerald-700">GOV.UK — Student loan repayment</a></li>
          <li><a href="https://www.gov.uk/national-minimum-wage-rates" target="_blank" rel="noopener" class="font-semibold text-emerald-600 hover:text-emerald-700">GOV.UK — National Minimum Wage rates</a></li>
          <li><a href="https://www.gov.uk/tax-codes" target="_blank" rel="noopener" class="font-semibold text-emerald-600 hover:text-emerald-700">GOV.UK — Understanding your tax code</a></li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-slate-900">Update Schedule</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Wagecheck updates its calculators every April when the new tax year begins. This is when HMRC publishes updated income tax bands, National Insurance thresholds, student loan repayment thresholds and other rates. We review and apply all changes within the first week of the new tax year. Outside of the annual update, we correct any errors or misinterpretations as soon as they are identified. Each calculator page includes a change log so you can see exactly when rates were last updated.
        </p>
