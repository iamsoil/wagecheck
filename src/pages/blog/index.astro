---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Blog | wagecheck"
  description="Guides, explainers and updates on UK salary, tax, National Insurance and property costs from the wagecheck team."
  breadcrumbName="Blog"
>
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">Blog</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Guides &amp; <span class="font-display italic text-emerald-600">Updates</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
        Explainers on UK tax, salary, National Insurance and property costs — written to help you understand your money.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <a href="/blog/tax-codes-guide/" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all duration-200 hover:border-emerald-200 hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Guide</p>
        <h2 class="mt-3 text-xl font-bold text-slate-900 group-hover:text-emerald-700">UK Tax Codes Explained: 1257L, BR, D0, K and More (2026/27)</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">What your tax code means, how to check it, and what to do if it's wrong. Covers every common code for the 2026/27 tax year.</p>
        <span class="mt-4 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">Read &rarr;</span>
      </a>

      <a href="/blog/self-employed-tax-guide/" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all duration-200 hover:border-emerald-200 hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Guide</p>
        <h2 class="mt-3 text-xl font-bold text-slate-900 group-hover:text-emerald-700">Self-Employed Tax Guide UK 2026/27: Income Tax, NICs & Deadlines</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Complete guide to income tax, Class 2 and Class 4 NICs, payments on account, expenses and self-assessment deadlines for sole traders.</p>
        <span class="mt-4 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">Read &rarr;</span>
      </a>

      <a href="/blog/minimum-wage-guide/" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all duration-200 hover:border-emerald-200 hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Guide</p>
        <h2 class="mt-3 text-xl font-bold text-slate-900 group-hover:text-emerald-700">National Minimum Wage 2026/27 UK: Rates, Rights & Take-Home Pay</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">Current NMW and NLW rates by age, apprentice pay, your legal rights, and how much minimum wage workers actually take home.</p>
        <span class="mt-4 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">Read &rarr;</span>
      </a>
    </div>
  </section>
</Layout>
