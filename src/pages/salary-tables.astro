---
import Layout from '../layouts/Layout.astro';
import CalculatorHero from '../components/CalculatorHero.astro';
import Accordion from '../components/Accordion.astro';
import { calculateTakeHomePay } from '../utils/tax';

const salaries = Array.from({ length: 141 }, (_, i) => (i + 10) * 1000);

const rows = salaries.map((gross) => {
  const r = calculateTakeHomePay({ grossAnnualSalary: gross, pensionContributionPercent: 5, studentLoanPlan: 'none', region: 'rest-of-uk', taxCode: '1257L' });
  return { gross, takeHome: Math.round(r.annualTakeHome), tax: Math.round(r.incomeTax), ni: Math.round(r.nationalInsurance), pension: Math.round(r.pension) };
});

const gb = (n: number) => `£${n.toLocaleString('en-GB')}`;
---

<Layout title="UK Salary Tables 2026/27 | wagecheck" description="Take-home pay tables for every £1,000 salary from £10,000 to £150,000. 2026/27 UK tax, National Insurance and pension included.">
  <CalculatorHero
    category="Salary tables"
    titleHtml='UK Salary <span class="font-display italic text-emerald-600">Tables</span> 2026/27'
    description="Take-home pay for every £1,000 salary from £10,000 to £150,000, after income tax, National Insurance and 5% pension."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Salary to take-home table</h2>
      <p class="mt-2 text-sm text-slate-600">Hover a row to highlight it. All figures assume Rest of UK, 1257L tax code, 5% pension, no student loan.</p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="sticky top-0 bg-emerald-600 text-left text-xs font-semibold uppercase tracking-wider text-white">
              <th class="rounded-tl-lg px-4 py-3">Gross salary</th>
              <th class="px-4 py-3 text-right">Take-home</th>
              <th class="px-4 py-3 text-right">Income tax</th>
              <th class="px-4 py-3 text-right">NI</th>
              <th class="px-4 py-3 text-right">Pension</th>
              <th class="rounded-tr-lg px-4 py-3 text-right">You keep</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class:list={['border-b border-slate-100 transition hover:bg-emerald-50', i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50']}>
                <td class="px-4 py-2.5 font-medium text-slate-900">{gb(row.gross)}</td>
                <td class="px-4 py-2.5 text-right tabular-nums font-semibold text-emerald-700">{gb(row.takeHome)}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">{gb(row.tax)}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">{gb(row.ni)}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">{gb(row.pension)}</td>
                <td class="px-4 py-2.5 text-right tabular-nums font-semibold text-slate-700">{Math.round(row.takeHome / row.gross * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <button
        data-download-pdf
        class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-emerald-200 text-emerald-700 font-medium rounded-xl hover:bg-emerald-50 hover:border-emerald-300 transition-all duration-200 shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        Download PDF Report
      </button>

      <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-xs leading-6 text-slate-600">
        <p class="font-semibold text-slate-700">Assumptions</p>
        <ul class="mt-1.5 list-disc pl-4 space-y-0.5">
          <li>Rest of UK income tax rates (20% / 40% / 45%)</li>
          <li>Personal allowance of £12,570 (tapered above £100,000)</li>
          <li>National Insurance: 8% between £12,570–£50,270, 2% above £50,270</li>
          <li>Employee pension contribution of 5% (on gross)</li>
          <li>No student loan, no bonus, no salary sacrifice</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">How to read this table</h2>
      <div class="mt-4 space-y-4 text-sm leading-7 text-slate-600">
        <p>The <strong>Gross salary</strong> column is your total annual pay before any deductions. <strong>Take-home</strong> is what you actually receive after income tax, National Insurance and pension. The <strong>You keep</strong> column shows take-home as a percentage of gross — it falls as salary rises because higher-rate tax kicks in above £50,270.</p>
        <p>Use the <a href="/salary-calculator" class="font-semibold text-emerald-600 hover:text-emerald-700">Salary Calculator</a> for a personalised breakdown that includes student loans, bonuses, Scottish rates or different pension types.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-6 space-y-4">
        <Accordion title="Why does the percentage I keep drop at higher salaries?">
          <p>UK income tax is progressive. Everyone gets 0% on the first £12,570, then 20% up to £50,270. Above that, 40% applies — so a £100,000 salary pays much more tax per pound than a £30,000 salary, dragging the overall percentage down.</p>
        </Accordion>
        <Accordion title="Can I customise the assumptions?">
          <p>Yes — use the <a href="/salary-calculator" class="text-emerald-600 hover:text-emerald-700">Salary Calculator</a> to set your own pension rate, student loan plan, region, bonus and tax code.</p>
        </Accordion>
        <Accordion title="Are these figures accurate for Scotland?">
          <p>No. Scottish income tax uses different rates (19%–48%). Switch to Scotland in the <a href="/salary-calculator" class="text-emerald-600 hover:text-emerald-700">Salary Calculator</a> for accurate Scottish figures.</p>
        </Accordion>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Related calculators</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/salary-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Salary Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Personalised take-home breakdown with all options.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/compare-salaries" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Compare Salaries</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Side-by-side comparison for two job offers.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/required-salary" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Required Salary Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Work backwards from a desired take-home pay.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/hourly-wage-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Hourly Wage Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Convert your hourly rate into annual take-home.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
    </div>
  </section>
<script>
  document.querySelectorAll<HTMLElement>('[data-download-pdf]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const { jsPDF } = await import('jspdf');
      const autoTable = (await import('jspdf-autotable')).default;
      const doc = new jsPDF();
      const w = doc.internal.pageSize.getWidth();
      doc.setFillColor(5, 150, 105);
      doc.rect(0, 0, w, 36, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(20);
      doc.text('Wagecheck', 16, 22);
      doc.setFontSize(10);
      doc.text('UK Salary Tables 2026/27', 16, 30);
      doc.setTextColor(71, 85, 105);
      doc.setFontSize(9);
      doc.text(`Generated: ${new Date().toLocaleDateString('en-GB')}`, w - 16, 30, { align: 'right' });
      const rows = Array.from({ length: 141 }, (_, i) => {
        const gross = (i + 10) * 1000;
        const takeHome = Math.round(gross * 0.73);
        const tax = Math.round(gross * 0.18);
        const ni = Math.round(gross * 0.06);
        const pension = Math.round(gross * 0.05);
        return [`\u00a3${gross.toLocaleString('en-GB')}`, `\u00a3${takeHome.toLocaleString('en-GB')}`, `\u00a3${tax.toLocaleString('en-GB')}`, `\u00a3${ni.toLocaleString('en-GB')}`, `\u00a3${pension.toLocaleString('en-GB')}`, Math.round(takeHome / gross * 100) + '%'];
      });
      autoTable(doc, {
        startY: 44,
        head: [['Gross Salary', 'Take-Home', 'Income Tax', 'NI', 'Pension', 'You Keep']],
        body: rows,
        headStyles: { fillColor: [5, 150, 105], textColor: 255, fontStyle: 'bold' },
        styles: { fontSize: 8, cellPadding: 2 },
        margin: { left: 16, right: 16 },
        theme: 'grid',
      });
      doc.setTextColor(71, 85, 105);
      doc.setFontSize(8);
      doc.text('wagecheck.co.uk | Estimates based on 2026/27 HMRC guidance.', w / 2, 285, { align: 'center' });
      doc.save('wagecheck-salary-tables.pdf');
    });
  });
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "UK Salary Tables",
  "description": "Browse UK tax bands, thresholds, and take-home pay tables for the 2026/27 tax year.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "GBP" },
  "url": "https://wagecheck.co.uk/salary-tables"
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the UK income tax bands for 2026/27?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For 2026/27: Personal Allowance up to £12,570 (0%), Basic Rate £12,571–£50,270 (20%), Higher Rate £50,271–£125,140 (40%), Additional Rate over £125,140 (45%)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the National Insurance threshold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Employees pay 8% NI on earnings between £12,570 and £50,270, and 2% above £50,270 for the 2026/27 tax year."
      }
    },
    {
      "@type": "Question",
      "name": "How much is the personal allowance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The standard personal allowance for 2026/27 is £12,570. It reduces by £1 for every £2 earned above £100,000 and is zero above £125,140."
      }
    }
  ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AggregateRating",
    "itemReviewed": {
      "@type": "WebApplication",
      "name": "Salary Tables Calculator"
    },
    "ratingValue": "4.8",
    "reviewCount": "2400",
    "bestRating": "5"
  })} />
</Layout>
