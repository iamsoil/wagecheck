---
import Layout from '../layouts/Layout.astro';
import CalculatorHero from '../components/CalculatorHero.astro';
import SalaryCalculator from '../components/SalaryCalculator.astro';
import Accordion from '../components/Accordion.astro';
import { calculateTakeHomePay } from '../lib/calculations';

const popularSalaries = [30000, 35000, 40000, 50000, 60000, 70000, 80000, 100000];

const popular = popularSalaries.map((amount) => {
  const result = calculateTakeHomePay({
    grossAnnualSalary: amount,
    pensionContributionPercent: 5,
    studentLoanPlan: 'plan2',
    region: 'rest-of-uk',
    hoursPerWeek: 37.5,
    taxCode: '1257L',
  });
  return {
    amount,
    monthly: Math.round(result.monthlyTakeHome).toLocaleString('en-GB'),
  };
});
---

<Layout
  title="Take-Home Pay Calculator 2026/27 | wagecheck"
  description="Calculate your take-home pay for 2026/27. Free UK salary calculator covering income tax, National Insurance, Scottish tax bands, student loans and pensions."
>
  <CalculatorHero
    category="Salary calculator"
    titleHtml='Take-Home Pay <span class="font-display italic text-emerald-600">Calculator</span> 2026/27'
    description="Enter your salary and instantly see your monthly and annual take-home pay after income tax, National Insurance, student loans and pension — with Scottish tax bands included."
    mobileDescription="See your take-home pay after tax, NI and pension."
  />

  <section class="calc-section mx-auto max-w-7xl px-4 py-8 md:py-12 sm:px-6 lg:px-8">
    <SalaryCalculator />
  </section>

  <section class="mx-auto max-w-7xl px-4 py-12 md:py-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-10">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">What is Take-Home Pay?</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Take-home pay is the amount of money you actually receive in your bank account after all statutory deductions have been taken from your gross salary. In the UK, the main deductions are income tax, National Insurance contributions, pension contributions and student loan repayments. Your gross salary is the figure quoted in your employment contract, but it is not the amount you spend — your take-home pay is. Understanding the difference between gross and net pay helps you budget accurately, compare job offers on a like-for-like basis, and plan for major financial decisions like buying a home or saving for retirement.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">How is UK Income Tax Calculated?</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          UK income tax uses a progressive band system. Everyone gets a Personal Allowance of £12,570 (2026/27) on which no tax is paid. Earnings above this are taxed in bands: the basic rate of 20% applies to income between £12,571 and £50,270; the higher rate of 40% applies between £50,271 and £125,140; and the additional rate of 45% applies above £125,140. Your Personal Allowance reduces by £1 for every £2 you earn above £100,000, so it is fully lost at £125,140. This means that if you earn between £100,000 and £125,140, your effective marginal tax rate is 60% — combining the 40% higher rate with the Personal Allowance taper. Scotland uses different rates (19%, 20%, 21%, 42%, 45% and 48%) but the same Personal Allowance. Our calculator applies these rules automatically based on your selected region.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">What is National Insurance?</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          National Insurance is a separate tax on earned income that funds the State Pension and contributory benefits. For employees in 2026/27, Class 1 NI is charged at 8% on earnings between £12,570 and £50,270, then 2% above £50,270. Unlike income tax, NI is calculated on a weekly or monthly basis rather than annually, which means you can pay slightly different amounts depending on your pay frequency. Self-employed individuals pay Class 2 and Class 4 NICs instead. National Insurance is deducted alongside income tax and appears as a separate line on your payslip.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-slate-100 bg-gradient-to-br from-emerald-50 via-white to-lime-50 p-6 sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Popular salaries</h2>
      <p class="mt-2 text-sm text-slate-600">Jump straight to the take-home breakdown for common salary levels (5% pension, Plan 2 student loan).</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          popular.map(({ amount, monthly }) => (
            <a
              href={`/salary/${amount}`}
              class="group rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition hover:border-emerald-200 hover:shadow-md"
            >
              <div class="flex items-center justify-between">
                <p class="text-lg font-bold text-slate-900">£{amount.toLocaleString('en-GB')}</p>
                <svg class="h-4 w-4 text-emerald-500 transition group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </div>
              <p class="mt-1 text-sm text-slate-500"><span class="font-semibold text-emerald-700">£{monthly}</span> a month take-home</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Go further</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <a href="/scottish-salary-calculator/" class="group rounded-2xl border border-emerald-200 bg-emerald-50 p-6 shadow-sm transition hover:border-emerald-300 hover:shadow-md">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-slate-900">Scottish Salary Calculator</h3>
          <svg class="h-5 w-5 text-emerald-500 transition group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-600">Live in Scotland? Use our Scottish salary calculator with 2026/27 bands to see your take-home pay.</p>
      </a>
      <a href="/compare-salaries/" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-slate-900">Compare Salaries</h3>
          <svg class="h-5 w-5 text-emerald-500 transition group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-600">Put two salaries side by side and see exactly how much more you keep after tax and deductions.</p>
      </a>
      <a href="/salary-tables/" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-slate-900">Salary Tables</h3>
          <svg class="h-5 w-5 text-emerald-500 transition group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </div>
        <p class="mt-2 text-sm leading-6 text-slate-600">Browse take-home pay for every salary between £15,000 and £100,000 in a single table.</p>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-6 space-y-4">
        <Accordion title="Why does my estimated take-home pay differ from my official payslip?">
          <p>
            Your payslip may include company-specific deductions such as healthcare, cycle-to-work, season ticket loans or salary sacrifice schemes. This calculator covers the main statutory deductions (income tax, National Insurance, student loans and pensions) using 2026/27 rates, so small differences are normal. Make sure the tax code used here matches the one on your payslip for the closest estimate.
          </p>
        </Accordion>
        <Accordion title="How is Class 1 National Insurance calculated for employees in 2026/27?">
          <p>
            Class 1 National Insurance is charged at 8% on earnings between £12,570 and £50,270, then 2% on anything above £50,270. If your pension is deducted from qualifying earnings rather than your full salary, the taxable base changes — the calculator reflects both options.
          </p>
        </Accordion>
        <Accordion title="How does student loan repayment affect my final take-home salary?">
          <p>
            Repayments are 9% of earnings above your plan threshold (6% for a Postgraduate Loan). For 2026/27 the thresholds are Plan 1 £24,990, Plan 2 £27,295, Plan 4 £31,395 and Plan 5 £25,000. Repayments are calculated on your pre-tax income after pension, which is why the deduction grows as your salary rises.
          </p>
        </Accordion>
        <Accordion title="How do Scottish income tax bands differ from the rest of the UK?">
          <p>
            Scotland sets its own income tax rates. For 2026/27 the Scottish bands are 19% starter rate, 20% basic rate, 21% intermediate rate, 42% higher rate, 45% advanced rate and 48% top rate, applied above the same £12,570 personal allowance. The rest of the UK uses 20%, 40% and 45%. National Insurance rules are the same everywhere.
          </p>
        </Accordion>
        <Accordion title="What if I'm off sick?">
          <p>
            If you're employed, your employer pays Statutory Sick Pay (SSP) from day 1 under the new April 2026 rules — no waiting period, no minimum earnings threshold. Use our <a href="/sick-pay-calculator/" class="text-emerald-600 hover:text-emerald-700 font-semibold">sick pay calculator</a> to work out exactly how much SSP you'll receive based on your salary and sick days.
          </p>
        </Accordion>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">How We Calculate This</h2>
      <div class="mt-4 space-y-4 text-sm leading-7 text-slate-600">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <p class="font-semibold text-slate-900">Tax year</p>
            <p>2026/27 (6 April 2026 – 5 April 2027)</p>
          </div>
          <div>
            <p class="font-semibold text-slate-900">Last reviewed</p>
            <p>30 August 2026</p>
          </div>
          <div>
            <p class="font-semibold text-slate-900">Default assumptions</p>
            <p>Pension: 5% · Tax code: 1257L · Working hours: 37.5/week · Student loan: none</p>
          </div>
          <div>
            <p class="font-semibold text-slate-900">Sources</p>
            <p><a href="https://www.gov.uk/income-tax-rates" target="_blank" rel="noopener" class="text-emerald-600 hover:text-emerald-700 font-semibold">GOV.UK — Income Tax rates and allowances</a> · <a href="https://www.gov.uk/national-insurance-rates-letters" target="_blank" rel="noopener" class="text-emerald-600 hover:text-emerald-700 font-semibold">GOV.UK — National Insurance rates</a></p>
          </div>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-amber-800">
          <p>Results are estimates. Your payslip may include employer-specific deductions such as salary sacrifice, healthcare, or cycle-to-work schemes.</p>
        </div>
      </div>
    </div>
  </section>

  <details class="mx-auto max-w-7xl px-4 pb-16 md:pb-24 sm:px-6 lg:px-8">
    <summary class="cursor-pointer rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8 text-lg font-bold tracking-tight text-slate-900 transition hover:bg-slate-50">Change Log</summary>
    <div class="mt-4 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8 text-sm text-slate-600 space-y-2">
      <p><span class="font-semibold text-slate-900">6 April 2026:</span> Tax year 2026/27 rates applied — income tax bands and NI thresholds updated.</p>
      <p><span class="font-semibold text-slate-900">1 January 2026:</span> Initial calculator built with 2025/26 rates, migrated to 2026/27 at start of tax year.</p>
    </div>
  </details>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'UK Salary Calculator 2026/27',
    'description': 'Calculate your take-home pay after tax, National Insurance, pension and student loan deductions.',
    'applicationCategory': 'FinanceApplication',
    'operatingSystem': 'Any',
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'GBP' },
    'url': 'https://www.wagecheck.co.uk/salary-calculator'
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Why does my estimated take-home pay differ from my official payslip?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Your payslip may include company-specific deductions such as healthcare or salary sacrifice schemes. This calculator covers income tax, National Insurance, student loans and pensions using 2026/27 rates.',
        },
      },
      {
        '@type': 'Question',
        name: 'How is Class 1 National Insurance calculated for employees in 2026/27?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Class 1 National Insurance is charged at 8% on earnings between £12,570 and £50,270, then 2% on anything above £50,270.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does student loan repayment affect my final take-home salary?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Repayments are 9% of earnings above your plan threshold (6% for a Postgraduate Loan). Thresholds for 2026/27: Plan 1 £24,990, Plan 2 £27,295, Plan 4 £31,395, Plan 5 £25,000.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do Scottish income tax bands differ from the rest of the UK?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Scotland uses 19%, 20%, 21%, 42%, 45% and 48% bands for 2026/27 above the £12,570 personal allowance. The rest of the UK uses 20%, 40% and 45%.',
        },
      },
      {
        '@type': 'Question',
        name: "What if I'm off sick?",
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'If you are employed, your employer pays Statutory Sick Pay (SSP) from day 1 under the new April 2026 rules. Use the sick pay calculator to work out your SSP based on your salary and sick days.',
        },
      },
    ],
  })} />

</Layout>
