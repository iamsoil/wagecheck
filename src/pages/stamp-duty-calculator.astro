---
import Layout from '../layouts/Layout.astro';
import CalculatorHero from '../components/CalculatorHero.astro';
import StampDutyCalculator from '../components/StampDutyCalculator.astro';
import Accordion from '../components/Accordion.astro';
---

<Layout
  title="Stamp Duty Calculator 2026/27 | wagecheck"
  description="Estimate stamp duty, LBTT and LTT for 2026/27. Free UK property tax calculator for England & Northern Ireland, Wales and Scotland with band-by-band results."
>
  <CalculatorHero
    category="Stamp duty calculator"
    titleHtml='Stamp Duty <span class="font-display italic text-emerald-600">Calculator</span> 2026/27'
    description="Estimate the tax due on your property purchase across England & Northern Ireland, Wales or Scotland — with a clear band-by-band breakdown and first-time buyer relief."
    mobileDescription="Work out SDLT on your property purchase."
  />

  <section class="calc-section mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <StampDutyCalculator />
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-3xl space-y-10">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">What is Stamp Duty?</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Stamp Duty Land Tax (SDLT) is a tiered tax you pay when purchasing a property or land in England and Northern Ireland. The amount you owe depends on the purchase price and whether you are a first-time buyer, buying a main residence, or purchasing a second home. Scotland uses a separate system called the Land and Buildings Transaction Tax (LBTT), while Wales uses the Land Transaction Tax (LTT). The rates and thresholds differ across all three systems, so it is essential to use the right calculator for your location. Stamp duty is usually paid on completion and must be filed with HMRC (or Revenue Scotland / Welsh Revenue Authority) within 14 days.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Stamp Duty for First-Time Buyers</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          First-time buyers in England and Northern Ireland benefit from an enhanced nil-rate band of £425,000, meaning you pay no stamp duty on the first £425,000 of a property purchase. Between £425,001 and £625,000 you pay 5%, and above £625,000 the standard rates apply. This relief can save first-time buyers thousands of pounds compared to existing homeowners. In Scotland, first-time buyers get a higher nil-rate band of £175,000 under LBTT. Wales does not currently offer a first-time buyer relief — all buyers pay the same LTT rates. To qualify as a first-time buyer, you (and anyone else you are buying with) must never have owned a residential property anywhere in the world.
        </p>
      </div>

      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Stamp Duty Rates Table</h2>
        <p class="mt-4 text-sm text-slate-600">England &amp; Northern Ireland (SDLT) — Main residence:</p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                <th class="px-4 py-3">Property Price</th>
                <th class="px-4 py-3">Standard Rate</th>
                <th class="px-4 py-3">First-Time Buyer</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 font-medium text-slate-900">Up to £250,000</td>
                <td class="px-4 py-3 text-emerald-700 font-semibold">0%</td>
                <td class="px-4 py-3 text-emerald-700 font-semibold">0%</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 font-medium text-slate-900">£250,001 – £425,000</td>
                <td class="px-4 py-3 font-semibold text-slate-900">5%</td>
                <td class="px-4 py-3 text-emerald-700 font-semibold">0%</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 font-medium text-slate-900">£425,001 – £625,000</td>
                <td class="px-4 py-3 font-semibold text-slate-900">5%</td>
                <td class="px-4 py-3 font-semibold text-slate-900">5%</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 font-medium text-slate-900">£625,001 – £925,000</td>
                <td class="px-4 py-3 font-semibold text-slate-900">10%</td>
                <td class="px-4 py-3 font-semibold text-slate-900">10%</td>
              </tr>
              <tr class="border-b border-slate-100">
                <td class="px-4 py-3 font-medium text-slate-900">£925,001 – £1,500,000</td>
                <td class="px-4 py-3 font-semibold text-slate-900">10%</td>
                <td class="px-4 py-3 font-semibold text-slate-900">10%</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-medium text-slate-900">Over £1,500,000</td>
                <td class="px-4 py-3 font-semibold text-slate-900">12%</td>
                <td class="px-4 py-3 font-semibold text-slate-900">12%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-6 space-y-4">
        <Accordion title="How much is stamp duty on a house in 2026/27?">
          <p>
            In England &amp; Northern Ireland you pay no stamp duty on the first £250,000 (up to £425,000 for first-time buyers), then 5% up to £925,000, 10% up to £1.5m and 12% above that. Wales (LTT) and Scotland (LBTT) use their own bands — select the right location above to see the exact figures.
          </p>
        </Accordion>
        <Accordion title="Do first-time buyers pay stamp duty?">
          <p>
            In England &amp; Northern Ireland, first-time buyers pay no stamp duty on properties up to £425,000 and a reduced rate up to £625,000. In Scotland the LBTT zero band is raised to £175,000 for first-time buyers. Wales does not offer a first-time buyer relief.
          </p>
        </Accordion>
        <Accordion title="How does Scottish stamp duty (LBTT) differ from England?">
          <p>
            Scotland's Land and Buildings Transaction Tax (LBTT) starts at 0% up to £145,000 (or £175,000 for first-time buyers), then 2%, 5%, 10% and 12% on higher bands. Buying an additional residential property in Scotland also triggers a 6% Additional Dwelling Supplement.
          </p>
        </Accordion>
        <Accordion title="Do buy-to-let buyers pay a surcharge?">
          <p>
            Yes. Buying a second home or buy-to-let property in England &amp; Northern Ireland adds 3% to every band, and in Scotland a 6% Additional Dwelling Supplement applies. Non-UK residents buying in England &amp; Northern Ireland pay an extra 2% surcharge.
          </p>
        </Accordion>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
      <p class="text-sm font-semibold text-amber-800">Important note</p>
      <p class="mt-1 text-sm leading-6 text-amber-700">
        Calculations are estimates based on 2026/27 rates. Not financial advice. Always confirm the final figure with HMRC, Revenue Scotland or the Welsh Revenue Authority before completing your purchase.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'Stamp Duty Calculator',
    'description': 'Calculate Stamp Duty Land Tax (SDLT) on property purchases in England and Northern Ireland.',
    'applicationCategory': 'FinanceApplication',
    'operatingSystem': 'Any',
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'GBP' },
    'url': 'https://www.wagecheck.co.uk/stamp-duty-calculator'
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How much is stamp duty on a house in 2026/27?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'In England & Northern Ireland stamp duty is 0% up to £250,000 (up to £425,000 for first-time buyers), then 5%, 10% and 12% on higher bands. Wales and Scotland use their own land transaction taxes.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do first-time buyers pay stamp duty?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'First-time buyers in England & Northern Ireland pay no stamp duty up to £425,000, and in Scotland the LBTT zero band is raised to £175,000. Wales does not offer first-time buyer relief.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does Scottish stamp duty (LBTT) differ from England?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Scotland uses LBTT with bands starting at 0% up to £145,000 (or £175,000 for first-time buyers), plus a 6% Additional Dwelling Supplement for additional homes.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do buy-to-let buyers pay a surcharge?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Buying a second home or buy-to-let property in England & Northern Ireland adds 3% to every band, and in Scotland a 6% Additional Dwelling Supplement applies.',
        },
      },
    ],
  })} />

</Layout>
