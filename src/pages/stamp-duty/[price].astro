---
import Layout from '../../layouts/Layout.astro';
import OdometerNumber from '../../components/OdometerNumber.astro';
import StampDutyCalculator from '../../components/StampDutyCalculator.astro';
import { calculateStampDuty } from '../../lib/calculations';

export async function getStaticPaths() {
  const prices = [];

  for (let price = 100000; price <= 1000000; price += 25000) {
    const calculation = calculateStampDuty(price, 'england', 'standard');

    prices.push({
      params: { price: price.toString() },
      props: { price, calculation },
    });
  }

  return prices;
}

const { price, calculation } = Astro.props as {
  price: number;
  calculation: ReturnType<typeof calculateStampDuty>;
};

const currencyFormatter = new Intl.NumberFormat('en-GB', {
  style: 'currency',
  currency: 'GBP',
  maximumFractionDigits: 0,
});

const percentFormatter = new Intl.NumberFormat('en-GB', {
  maximumFractionDigits: 1,
});

function formatCurrency(value: number) {
  return currencyFormatter.format(Math.round(value));
}

function formatPercent(value: number) {
  return `${percentFormatter.format(value)}%`;
}
---

<Layout
  title={`£${price.toLocaleString('en-GB')} Stamp Duty 2026/27 | Wagecheck`}
  description={`Estimate stamp duty on a £${price.toLocaleString('en-GB')} property for 2026/27 with band-by-band results.`}
>
  <section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">Stamp duty SEO page</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Stamp Duty on £{price.toLocaleString('en-GB')} Property in 2026/27</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl">
          See how much stamp duty is due on this property price using 2026/27 rules for England and Northern Ireland.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#f8fafc]">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Total stamp duty</p>
          <OdometerNumber value={calculation.total} duration={1200} class="mt-3 text-5xl font-bold text-emerald-600" />
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Effective tax rate</p>
          <OdometerNumber value={calculation.effectiveRate} prefix="" duration={800} class="mt-3 text-3xl font-bold text-slate-900" />
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Property price</p>
          <OdometerNumber value={price} duration={800} class="mt-3 text-3xl font-bold text-slate-900" />
        </article>
        <article class="rounded-2xl border border-slate-200 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm">
          <p class="text-sm font-medium text-slate-500">Tax share</p>
          <OdometerNumber value={calculation.effectiveRate} prefix="" duration={800} class="mt-3 text-3xl font-bold text-slate-900" />
        </article>
      </div>

      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-semibold text-slate-900">Breakdown by band</h2>
        <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
          <div class="grid grid-cols-[1.6fr_0.7fr_0.9fr] gap-3 border-b border-slate-200 bg-slate-50 px-4 py-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
            <span>Band</span>
            <span>Rate</span>
            <span class="text-right">Tax</span>
          </div>
          <div class="divide-y divide-slate-200">
            {calculation.bands.map((band) => (
              <div class="grid grid-cols-[1.6fr_0.7fr_0.9fr] gap-3 px-4 py-4 text-sm text-slate-600">
                <div>
                  <p class="font-medium text-slate-900">{band.label}</p>
                  <p class="mt-1 text-xs text-slate-500">{formatCurrency(band.taxableAmount)} taxed in this band</p>
                </div>
                <div class="font-medium text-slate-700">{formatPercent(band.rate * 100)}</div>
                <div class="text-right font-semibold text-slate-900">{formatCurrency(band.tax)}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center">
          <div>
            <h2 class="text-lg font-semibold text-slate-900">Duty vs property price</h2>
            <p class="mt-2 text-sm text-slate-600">A simple visual showing how much of the purchase price goes toward tax.</p>
          </div>
          <div class="flex items-center justify-center">
            <div class="relative h-52 w-52 rounded-full" style={`background: conic-gradient(rgb(16 185 129) 0deg ${Math.min(calculation.effectiveRate, 100) * 3.6}deg, rgb(226 232 240) ${Math.min(calculation.effectiveRate, 100) * 3.6}deg 360deg);`}>
              <div class="absolute inset-7 rounded-full bg-white shadow-inner"></div>
              <div class="absolute inset-0 flex items-center justify-center text-center">
                <div>
                  <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate-500">Duty share</p>
                  <p class="mt-2 text-3xl font-bold text-slate-900">{formatPercent(calculation.effectiveRate)}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="mt-6 text-sm text-slate-600">Based on 2026/27 rates. Verify with HMRC before completing your purchase.</p>
    </div>
  </section>

  <StampDutyCalculator initialPropertyPrice={price} initialLocation="england" initialBuyerType="standard" />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `£${price.toLocaleString('en-GB')} Stamp Duty 2026/27`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    description: `Estimate stamp duty on a £${price.toLocaleString('en-GB')} property for 2026/27 with band-by-band results.`,
    url: `/stamp-duty/${price}`,
  })} />
</Layout>
