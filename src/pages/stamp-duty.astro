---
import Layout from '../layouts/Layout.astro';
import CalculatorHero from '../components/CalculatorHero.astro';
import Accordion from '../components/Accordion.astro';
---

<Layout
  title="What is Stamp Duty? | wagecheck"
  description="A plain-English guide to stamp duty land tax on UK property purchases, including rates, thresholds and exemptions for 2026/27."
>
  <CalculatorHero
    category="Stamp duty guide"
    titleHtml='What is <span class="font-display italic text-emerald-600">Stamp Duty</span>?'
    description="A plain-English guide to the property tax you pay when buying a home in the UK."
    cta={{ href: '/stamp-duty-calculator', label: 'Calculate Your Stamp Duty' }}
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-xl font-bold tracking-tight text-slate-900">What is stamp duty?</h2>
        <p class="mt-4 text-sm leading-7 text-slate-600">
          Stamp Duty Land Tax (SDLT) is a tax paid by the buyer when purchasing a property or land in England and Northern Ireland. Scotland and Wales have their own equivalents: LBTT and LTT respectively.
        </p>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          The amount you pay depends on the property price, your buyer type (first-time buyer, standard buyer, or buy-to-let investor), and where in the UK the property is located.
        </p>
      </div>
      <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-xl font-bold tracking-tight text-slate-900">England &amp; Northern Ireland rates (2026/27)</h2>
        <div class="mt-4 space-y-3">
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">Up to £250,000</span>
            <span class="font-semibold text-emerald-700">0%</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">£250,001 – £925,000</span>
            <span class="font-semibold text-emerald-700">5%</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">£925,001 – £1,500,000</span>
            <span class="font-semibold text-emerald-700">10%</span>
          </div>
          <div class="flex justify-between text-sm">
            <span class="text-slate-600">Above £1,500,000</span>
            <span class="font-semibold text-emerald-700">12%</span>
          </div>
        </div>
        <p class="mt-4 text-xs text-slate-500">First-time buyers get 0% on the first £425,000 (up to £625,000 total).</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-6 space-y-4">
        <Accordion title="Who pays stamp duty?">
          <p>The buyer pays stamp duty, not the seller. It is due within 14 days of completing the purchase, though most people pay through their solicitor at completion.</p>
        </Accordion>
        <Accordion title="Are first-time buyers exempt?">
          <p>Not fully, but they get relief. First-time buyers in England and Northern Ireland pay 0% on the first £425,000 (compared to £250,000 for other buyers), provided the total property price is £625,000 or less. Above £625,000, standard rates apply.</p>
        </Accordion>
        <Accordion title="What about buy-to-let and second homes?">
          <p>An additional 3% surcharge applies to buy-to-let properties and second homes in England and Northern Ireland. Non-UK residents pay a further 2% surcharge.</p>
        </Accordion>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Related tools</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/stamp-duty-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Stamp Duty Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Get an instant estimate for your property.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/salary-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Salary Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">See what you take home from your salary.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/compare-salaries" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Compare Salaries</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Side-by-side comparison for two job offers.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/salary-tables" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Salary Tables</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Take-home pay for every £1,000 salary.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
    </div>
  </section>
</Layout>
