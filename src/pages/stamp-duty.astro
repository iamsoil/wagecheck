---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Stamp Duty Calculator | wagecheck"
  description="Estimate stamp duty land tax on UK property purchases."
>
  <section class="bg-[#f8fafc]">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600">Stamp Duty Calculator</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900">Property tax estimates with clarity</h1>
        <p class="mt-4 text-base leading-7 text-slate-600">
          This page is ready for the stamp duty calculator flow and uses the same minimal fintech styling.
        </p>
      </div>
    </div>
  </section>
</Layout>