---
import Layout from '../layouts/Layout.astro';
import CalculatorHero from '../components/CalculatorHero.astro';
import CalculatorInput from '../components/CalculatorInput.astro';
import Accordion from '../components/Accordion.astro';

const inputClasses = 'w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100';

const defaultPrice = 250000;
const defaultAnnualRent = 15000;
const defaultMortgage = 0;
const defaultRate = 5;

const grossYield = (defaultAnnualRent / defaultPrice) * 100;
const annualInterest = defaultMortgage * (defaultRate / 100);
const netIncome = defaultAnnualRent - annualInterest;
const netYield = (netIncome / defaultPrice) * 100;
const monthlyRent = defaultAnnualRent / 12;

const gb = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });
const money = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;
---

<Layout
  title="Rental Yield Calculator 2026/27 | wagecheck"
  description="Calculate the gross and net rental yield on a UK buy-to-let property. Free rental yield calculator with mortgage interest deduction."
>
  <CalculatorHero
    category="Rental yield calculator"
    titleHtml='Rental Yield <span class="font-display italic text-emerald-600">Calculator</span> 2026/27'
    description="Calculate gross and net rental yield on a UK buy-to-let property."
    mobileDescription="Calculate buy-to-let rental yield."
  />

  <section class="calc-section mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div
      id="rental-yield-calculator"
      data-rental-yield
      data-initial-price={defaultPrice}
      data-initial-rent={defaultAnnualRent}
      data-initial-mortgage={defaultMortgage}
      data-initial-rate={defaultRate}
      class="grid gap-8 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]"
    >
      <div class="h-fit rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-900">Property details</h2>
        <div class="mt-5 space-y-5">
          <CalculatorInput label="Property price (£)">
            <input type="number" min="0" step="5000" value={defaultPrice} data-price class={inputClasses} />
          </CalculatorInput>
          <CalculatorInput label="Annual rent (£)">
            <input type="number" min="0" step="500" value={defaultAnnualRent} data-rent class={inputClasses} />
          </CalculatorInput>
          <CalculatorInput label="Mortgage amount (£)" hint="Leave blank or 0 if buying cash.">
            <input type="number" min="0" step="5000" value={defaultMortgage} data-mortgage class={inputClasses} />
          </CalculatorInput>
          <CalculatorInput label="Mortgage interest rate (%)" hint="Only needed if you have a mortgage.">
            <input type="number" min="0" max="20" step="0.1" value={defaultRate} data-mortgage-rate class={inputClasses} />
          </CalculatorInput>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-900">Your results</h2>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-teal-50 p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">Gross rental yield</p>
            <span data-var="grossYield" class="mt-2 block text-3xl font-bold tabular-nums text-emerald-700">{gb(grossYield)}%</span>
            <p class="mt-1 text-xs text-emerald-600/80">Annual rent / property price</p>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Net rental yield</p>
            <span data-var="netYield" class="mt-2 block text-3xl font-bold tabular-nums text-slate-900">{gb(netYield)}%</span>
            <p class="mt-1 text-xs text-slate-500">After mortgage interest</p>
          </div>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-slate-100 bg-white p-4">
            <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Monthly rent</p>
            <span data-var="monthlyRent" class="mt-1 block text-lg font-bold tabular-nums text-slate-900">{money(monthlyRent)}</span>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white p-4">
            <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Annual rent</p>
            <span data-var="annualRent" class="mt-1 block text-lg font-bold tabular-nums text-slate-900">{money(defaultAnnualRent)}</span>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white p-4">
            <p class="text-[11px] font-medium uppercase tracking-wider text-slate-500">Annual interest</p>
            <span data-var="annualInterest" class="mt-1 block text-lg font-bold tabular-nums text-slate-900">{money(annualInterest)}</span>
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-slate-100 bg-white p-5">
          <p class="text-sm font-semibold text-slate-900">Where your rental income goes</p>
          <div class="mt-3 flex h-4 w-full overflow-hidden rounded-full">
            <div data-var="barNetIncome" class="bg-emerald-500" style={`width:${defaultAnnualRent > 0 ? (netIncome / defaultAnnualRent) * 100 : 0}%;`}></div>
            <div data-var="barInterest" class:list={['bg-amber-500', defaultMortgage === 0 && 'hidden']} style={`width:${defaultAnnualRent > 0 ? (annualInterest / defaultAnnualRent) * 100 : 0}%;`}></div>
          </div>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            <span class="flex items-center gap-1.5 text-xs text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>Net income · <span data-var="legNetIncome" class="tabular-nums">{money(netIncome)}</span></span>
            <span data-leg-interest class:list={['flex items-center gap-1.5 text-xs text-slate-600', defaultMortgage === 0 && 'hidden']}><span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>Mortgage interest · <span data-var="legInterest" class="tabular-nums">{money(annualInterest)}</span></span>
          </div>
        </div>

        <button
          data-download-pdf
          class="hidden mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-emerald-200 text-emerald-700 font-medium rounded-xl hover:bg-emerald-50 hover:border-emerald-300 transition-all duration-200 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Download PDF Report
        </button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">How to Calculate Rental Yield</h2>
      <div class="mt-4 space-y-4 text-sm leading-7 text-slate-600">
        <p><strong>Gross rental yield</strong> is simply annual rent divided by the property price, multiplied by 100 to get a percentage. It gives you a quick snapshot of the return before any costs.</p>
        <p><strong>Net rental yield</strong> subtracts mortgage interest costs from the annual rent before calculating. This gives a more realistic picture of your actual return if you have a buy-to-let mortgage.</p>
        <p>A gross yield above 5% is generally considered good in the UK. Below 4% suggests the property may be expensive relative to its rental income, though yields vary significantly by region.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-6 space-y-4">
        <Accordion title="What is a good rental yield?">
          <p>In the UK, a gross rental yield above 5% is generally considered good. Yields vary by region: northern cities like Liverpool and Manchester often offer 6-8%, while London properties may yield 3-4%. Remember that higher yields sometimes correlate with lower capital growth potential.</p>
        </Accordion>
        <Accordion title="Does this include other landlord costs?">
          <p>This calculator only deducts mortgage interest. Real net yield should also account for letting agent fees (typically 8-12% of rent), maintenance, insurance, void periods and income tax on rental profits. Use this as a starting point, not the full picture.</p>
        </Accordion>
        <Accordion title="How does stamp duty affect my yield?">
          <p>Stamp duty is a one-off purchase cost, not an ongoing expense, so it doesn't directly affect your annual yield. However, it increases your total investment, which reduces your return on capital. Use the <a href="/stamp-duty-calculator" class="text-emerald-600 hover:text-emerald-700">Stamp Duty Calculator</a> to factor it into your overall investment analysis.</p>
        </Accordion>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Related calculators</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/stamp-duty-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Stamp Duty Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Estimate the tax when buying a property.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/salary-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Salary Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">See your take-home pay breakdown.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/compare-salaries" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Compare Salaries</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Side-by-side comparison for two job offers.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
      <a href="/required-salary" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Required Salary Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Work backwards from a desired take-home.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600">View &rarr;</span>
      </a>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-rental-yield]').forEach((root) => {
      const state = {
        price: parseFloat(root.dataset.initialPrice || '250000'),
        rent: parseFloat(root.dataset.initialRent || '15000'),
        mortgage: parseFloat(root.dataset.initialMortgage || '0'),
        rate: parseFloat(root.dataset.initialRate || '5'),
      };

      function recompute() {
        const grossYield = state.price > 0 ? (state.rent / state.price) * 100 : 0;
        const annualInterest = state.mortgage * (state.rate / 100);
        const netIncome = state.rent - annualInterest;
        const netYield = state.price > 0 ? (netIncome / state.price) * 100 : 0;
        const monthlyRent = state.rent / 12;

        const fmt = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });
        const moneyFmt = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;

        const set = (key: string, val: string) => {
          const el = root.querySelector<HTMLElement>(`[data-var="${key}"]`);
          if (el) el.textContent = val;
        };

        set('grossYield', `${fmt(grossYield)}%`);
        set('netYield', `${fmt(netYield)}%`);
        set('monthlyRent', moneyFmt(monthlyRent));
        set('annualRent', moneyFmt(state.rent));
        set('annualInterest', moneyFmt(annualInterest));
        set('legNetIncome', moneyFmt(netIncome));
        set('legInterest', moneyFmt(annualInterest));

        const barNet = root.querySelector<HTMLElement>('[data-bar-net-income]');
        const barInt = root.querySelector<HTMLElement>('[data-bar-interest]');
        if (barNet) barNet.style.width = `${state.rent > 0 ? (netIncome / state.rent) * 100 : 0}%`;
        if (barInt) {
          barInt.style.width = `${state.rent > 0 ? (annualInterest / state.rent) * 100 : 0}%`;
          barInt.classList.toggle('hidden', state.mortgage <= 0);
        }
        const legInt = root.querySelector<HTMLElement>('[data-leg-interest]');
        if (legInt) legInt.classList.toggle('hidden', state.mortgage <= 0);
      }

      let timer = 0;
      function schedule() {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => recompute(), 150);
      }

      const bind = (sel: string, key: string) => {
        const el = root.querySelector<HTMLInputElement>(sel);
        el?.addEventListener('input', () => {
          const raw = parseFloat(el.value);
          (state as any)[key] = Number.isFinite(raw) ? raw : 0;
          schedule();
        });
      };

      bind('[data-price]', 'price');
      bind('[data-rent]', 'rent');
      bind('[data-mortgage]', 'mortgage');
      bind('[data-mortgage-rate]', 'rate');

      recompute();

      // PDF download wiring
      const pdfBtn = root.querySelector<HTMLElement>('[data-download-pdf]');
      pdfBtn?.classList.remove('hidden');
      pdfBtn?.addEventListener('click', async () => {
        const { generateRentalYieldPDF } = await import('../utils/pdfExport.js');
        const grossYield = state.price > 0 ? (state.rent / state.price) * 100 : 0;
        const annualInterest = state.mortgage * (state.rate / 100);
        const netIncome = state.rent - annualInterest;
        const netYield = state.price > 0 ? (netIncome / state.price) * 100 : 0;
        const f = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });
        const m = (n: number) => `\u00a3${Math.round(n).toLocaleString('en-GB')}`;
        generateRentalYieldPDF({
          propertyPrice: m(state.price), monthlyRent: m(state.rent / 12),
          annualInterest: state.mortgage > 0 ? m(annualInterest) : null,
          grossYield: f(grossYield) + '%', netYield: f(netYield) + '%',
          annualRent: m(state.rent), propertyPriceRaw: state.price,
        });
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Rental Yield Calculator",
    "description": "Calculate gross and net rental yield on UK buy-to-let properties.",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "GBP" },
    "url": "https://www.wagecheck.co.uk/rental-yield"
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a good rental yield in the UK?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A gross rental yield of 5–8% is generally considered good in the UK. Yields vary significantly by location, with northern cities often offering higher returns than London."
        }
      },
      {
        "@type": "Question",
        "name": "How is rental yield calculated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Gross yield = (annual rent / property price) × 100. Net yield deducts costs like mortgage interest, maintenance, and void periods from the annual rent before dividing by property price."
        }
      },
      {
        "@type": "Question",
        "name": "What costs should I deduct for net yield?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For net yield, deduct mortgage interest, insurance, maintenance, letting agent fees, void periods, and ground rent/service charges from your annual rental income."
        }
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AggregateRating",
    "itemReviewed": {
      "@type": "WebApplication",
      "name": "Rental Yield Calculator"
    },
    "ratingValue": "4.8",
    "reviewCount": "2400",
    "bestRating": "5"
  })} />
</Layout>
