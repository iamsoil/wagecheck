---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rental Yield Calculator | wagecheck" description="Rental yield calculator coming soon.">
  <section class="bg-[#f8fafc]">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-600">Rental Yield Calculator</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900">Coming soon</h1>
        <p class="mt-4 text-base leading-7 text-slate-600">
          The rental yield tool will follow the same minimal interface and calculation standards.
        </p>
      </div>
    </div>
  </section>
</Layout>