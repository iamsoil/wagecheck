---
import Layout from '../layouts/Layout.astro';
import CalculatorHero from '../components/CalculatorHero.astro';
import CalculatorInput from '../components/CalculatorInput.astro';
import Accordion from '../components/Accordion.astro';
import { calculateTakeHomePay, calculateNationalInsurance } from '../utils/tax';

const defaultSalary = 35000;
const defaultBonus = 5000;
const defaultTaxCode = '1257L';
const defaultPension = 0;

const defaultResult = calculateTakeHomePay({
  grossAnnualSalary: defaultSalary,
  annualBonus: defaultBonus,
  pensionContributionPercent: defaultPension,
  studentLoanPlan: 'none',
  taxCode: defaultTaxCode,
});

const gb = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });
const money = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;
const pct1 = (n: number) => `${gb(n)}%`;

const inputClasses =
  'w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100';

const CIRCUMFERENCE = 502.65;

const pensionAmount = (defaultSalary * defaultPension) / 100;
const niWithout = calculateNationalInsurance(defaultSalary - pensionAmount);
const niWith = calculateNationalInsurance(defaultSalary - pensionAmount + defaultBonus);
const initialBonusNi = Math.max(niWith - niWithout, 0);
const initialBonusTax = defaultResult.bonusTax;
const initialNet = Math.max(defaultBonus - initialBonusTax - initialBonusNi, 0);
const initialPct = defaultBonus > 0 ? (initialNet / defaultBonus) * 100 : 0;
const initialOffset = CIRCUMFERENCE - (initialPct / 100) * CIRCUMFERENCE;
---

<Layout
  title="Bonus Tax Calculator 2026/27 | wagecheck"
  description="Calculate how much tax and National Insurance you'll pay on your bonus. Free UK bonus tax calculator for 2026/27 with marginal rate breakdown."
>
  <CalculatorHero
    category="Bonus calculator"
    titleHtml='Bonus Tax <span class="font-display italic text-emerald-600">Calculator</span> 2026/27'
    description="See how much tax and National Insurance you'll pay on your bonus — with marginal rate breakdown and donut chart."
    mobileDescription="See how much of your bonus you keep."
  />

  <section class="calc-section mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div
      id="bonus-calculator"
      data-bonus-calculator
      data-initial-salary={defaultSalary}
      data-initial-bonus={defaultBonus}
      data-initial-tax-code={defaultTaxCode}
      data-initial-pension={defaultPension}
      class="grid gap-8 lg:grid-cols-[minmax(0,420px)_minmax(0,1fr)]"
    >
      <div class="h-fit rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-900">Your details</h2>
        <div class="mt-5 space-y-5">
          <CalculatorInput label="Annual salary (£)" hint="Your base salary before bonus.">
            <input type="number" min="0" step="500" value={defaultSalary} data-salary class={inputClasses} />
          </CalculatorInput>
          <CalculatorInput label="Bonus amount (£)" hint="The gross bonus you expect to receive.">
            <input type="number" min="0" step="100" value={defaultBonus} data-bonus class={inputClasses} />
          </CalculatorInput>
          <CalculatorInput label="Tax code" hint="Found on your payslip, e.g. 1257L.">
            <input type="text" value={defaultTaxCode} data-tax-code class={inputClasses} />
          </CalculatorInput>
          <div>
            <div class="mb-1.5 flex items-center justify-between">
              <span class="text-sm font-semibold text-slate-700">Pension contribution</span>
              <span data-pension-value class="text-sm font-bold text-emerald-600">{defaultPension}%</span>
            </div>
            <input type="range" min="0" max="20" step="1" value={defaultPension} data-pension class="w-full accent-emerald-600" />
          </div>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-bold tracking-tight text-slate-900">Your results</h2>

        <div class="mt-6 flex justify-center">
          <div class="relative">
            <svg width="200" height="200" viewBox="0 0 200 200">
              <circle cx="100" cy="100" r="80" fill="none" stroke="#f1f5f9" stroke-width="14" />
              <circle
                data-donut="kept"
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="#10b981"
                stroke-width="14"
                stroke-linecap="round"
                stroke-dasharray={CIRCUMFERENCE}
                stroke-dashoffset={initialOffset}
                transform="rotate(-90 100 100)"
                class="transition-all duration-500"
              />
              <text x="100" y="95" text-anchor="middle" class="fill-slate-900 text-2xl font-bold" data-donut-text>
                {money(initialNet)}
              </text>
              <text x="100" y="115" text-anchor="middle" class="fill-slate-500 text-xs">
                you keep
              </text>
            </svg>
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-slate-100 bg-white p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Bonus Amount</p>
            <span data-card="bonus" class="mt-2 block text-lg font-bold text-slate-900">{money(defaultBonus)}</span>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Tax Deduction</p>
            <span data-card="tax" class="mt-2 block text-lg font-bold text-rose-600">{money(initialBonusTax)}</span>
          </div>
          <div class="rounded-2xl border border-slate-100 bg-white p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">NI Deduction</p>
            <span data-card="ni" class="mt-2 block text-lg font-bold text-blue-600">{money(initialBonusNi)}</span>
          </div>
          <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-emerald-600">You Keep</p>
            <span data-card="kept" class="mt-2 block text-lg font-bold text-emerald-700">{money(initialNet)}</span>
          </div>
        </div>

        <p data-description class="mt-4 text-sm leading-6 text-slate-600">
          Your bonus of {money(defaultBonus)} is taxed at a marginal rate of <span data-desc-rate>{pct1(initialBonusTax > 0 ? (initialBonusTax / defaultBonus) * 100 : 0)}</span>. You'll pay {money(initialBonusTax)} in income tax and {money(initialBonusNi)} in National Insurance.
        </p>

        <button
          data-download-pdf
          class="hidden mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-emerald-200 text-emerald-700 font-medium rounded-xl hover:bg-emerald-50 hover:border-emerald-300 transition-all duration-200 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Download PDF Report
        </button>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">How Bonuses Are Taxed</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white">1</div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900">Bonuses are added to your salary</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">HMRC treats your bonus as part of your total annual income, so it's taxed in the same way as your salary.</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white">2</div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900">Marginal tax rates apply</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">If your bonus pushes you into a higher tax band, only the portion above the threshold is taxed at the higher rate.</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white">3</div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900">National Insurance is charged</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">Class 1 NI is charged at 8% on earnings between £12,570 and £50,270, then 2% above the upper earnings limit.</p>
      </div>
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white">4</div>
        <h3 class="mt-4 text-sm font-semibold text-slate-900">Pension reduces the taxable amount</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">If you contribute to a workplace pension, this reduces the income on which your bonus tax is calculated.</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
      <div class="mt-6 space-y-4">
        <Accordion title="Is a bonus taxed differently from my salary?">
          <p>
            No. A bonus is treated as ordinary income by HMRC and taxed using the same income tax bands and rates as your salary. The key difference is that a one-off bonus can push part of your income into a higher marginal tax band for that tax year.
          </p>
        </Accordion>
        <Accordion title="Will my bonus push me into a higher tax bracket?">
          <p>
            It depends on your total taxable income. If your salary alone uses up your basic rate band (£50,270 for 2026/27), any bonus will be taxed at 40% or even 45%. If you're well below the higher rate threshold, your bonus may be taxed entirely at 20%.
          </p>
        </Accordion>
        <Accordion title="Do I pay National Insurance on my bonus?">
          <p>
            Yes. Employers typically process bonuses through payroll, meaning Class 1 National Insurance is deducted at 8% on earnings between the primary threshold (£12,570) and upper earnings limit (£50,270), then 2% on anything above.
          </p>
        </Accordion>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Related calculators</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/salary-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Salary Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Enter an annual salary and see your full take-home breakdown.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">View &rarr;</span>
      </a>
      <a href="/pay-rise-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Pay Rise Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">See how a pay rise affects your take-home pay after tax.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">View &rarr;</span>
      </a>
      <a href="/compare-salaries" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Compare Salaries</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Put two salaries side by side and compare take-home pay.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">View &rarr;</span>
      </a>
      <a href="/stamp-duty-calculator" class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:border-emerald-200 hover:shadow-md">
        <p class="text-base font-semibold text-slate-900">Stamp Duty Calculator</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Estimate the tax due when buying a property across the UK.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-emerald-600 transition group-hover:translate-x-0.5">View &rarr;</span>
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Bonus Tax Calculator 2026/27',
    url: '/bonus-calculator',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    description: 'Calculate how much tax and National Insurance you will pay on your bonus for the 2026/27 UK tax year.',
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is my bonus taxed differently from my salary?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bonuses are taxed through PAYE at your marginal rate. Your employer uses your tax code to deduct the right amount, but if it pushes you into a higher band, you may owe more."
        }
      },
      {
        "@type": "Question",
        "name": "Why does my bonus seem heavily taxed?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bonuses often appear to have more tax deducted because PAYE treats them as if you'll earn that amount every month. You usually reclaim any overpayment via your tax code or self-assessment."
        }
      },
      {
        "@type": "Question",
        "name": "Can I reduce tax on my bonus?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pension contributions, salary sacrifice schemes, and charitable donations can reduce your taxable income. Consult a financial advisor for personal strategies."
        }
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AggregateRating",
    "itemReviewed": {
      "@type": "WebApplication",
      "name": "Bonus Tax Calculator"
    },
    "ratingValue": "4.8",
    "reviewCount": "2400",
    "bestRating": "5"
  })} />

  <script>
    document.querySelectorAll<HTMLElement>('[data-bonus-calculator]').forEach((root) => {
      const CIRCUMFERENCE = 502.65;

      const salaryInput = root.querySelector<HTMLInputElement>('[data-salary]');
      const bonusInput = root.querySelector<HTMLInputElement>('[data-bonus]');
      const taxCodeInput = root.querySelector<HTMLInputElement>('[data-tax-code]');
      const pensionSlider = root.querySelector<HTMLInputElement>('[data-pension]');
      const pensionValue = root.querySelector<HTMLElement>('[data-pension-value]');

      function parseTaxCode(code: string): number {
        const match = code.trim().match(/^(\d+)/);
        if (!match) return 12570;
        const num = parseInt(match[1], 10);
        return Math.min(Math.max(num * 10, 0), 125140);
      }

      function incomeTaxBands(taxableIncome: number): number {
        if (taxableIncome <= 0) return 0;
        const band1 = Math.min(taxableIncome, 50270) * 0.2;
        const band2 = Math.max(Math.min(taxableIncome, 125140) - 50270, 0) * 0.4;
        const band3 = Math.max(taxableIncome - 125140, 0) * 0.45;
        return band1 + band2 + band3;
      }

      function calculateNI(salary: number): number {
        const pt = 12570;
        const uel = 50270;
        const main = Math.max(Math.min(salary - pt, uel - pt), 0) * 0.08;
        const additional = Math.max(salary - uel, 0) * 0.02;
        return main + additional;
      }

      function recalculate() {
        const salary = Math.max(parseFloat(salaryInput?.value || '0') || 0, 0);
        const bonus = Math.max(parseFloat(bonusInput?.value || '0') || 0, 0);
        const taxCode = taxCodeInput?.value || '1257L';
        const pensionPct = Math.min(Math.max(parseFloat(pensionSlider?.value || '0') || 0, 0), 20);

        if (pensionValue) pensionValue.textContent = `${pensionPct}%`;

        const pa = parseTaxCode(taxCode);
        const pensionAmount = (salary * pensionPct) / 100;
        const salaryAfterPension = Math.max(salary - pensionAmount, 0);

        const taxableWithout = Math.max(salaryAfterPension - pa, 0);
        const taxableWith = Math.max(salaryAfterPension + bonus - pa, 0);
        const taxWithout = incomeTaxBands(taxableWithout);
        const taxWith = incomeTaxBands(taxableWith);
        const bonusTax = Math.max(taxWith - taxWithout, 0);

        const niWithout = calculateNI(salaryAfterPension);
        const niWith = calculateNI(salaryAfterPension + bonus);
        const bonusNi = Math.max(niWith - niWithout, 0);

        const netKept = Math.max(bonus - bonusTax - bonusNi, 0);
        const pctKept = bonus > 0 ? (netKept / bonus) * 100 : 0;
        const offset = CIRCUMFERENCE - (pctKept / 100) * CIRCUMFERENCE;

        const format = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;
        const formatPct = (n: number) => `${n.toLocaleString('en-GB', { maximumFractionDigits: 1 })}%`;

        const donut = root.querySelector<SVGCircleElement>('[data-donut="kept"]');
        if (donut) donut.style.strokeDashoffset = String(offset);

        const donutText = root.querySelector<SVGTextElement>('[data-donut-text]');
        if (donutText) donutText.textContent = format(netKept);

        const cardBonus = root.querySelector<HTMLElement>('[data-card="bonus"]');
        const cardTax = root.querySelector<HTMLElement>('[data-card="tax"]');
        const cardNi = root.querySelector<HTMLElement>('[data-card="ni"]');
        const cardKept = root.querySelector<HTMLElement>('[data-card="kept"]');

        if (cardBonus) cardBonus.textContent = format(bonus);
        if (cardTax) cardTax.textContent = format(bonusTax);
        if (cardNi) cardNi.textContent = format(bonusNi);
        if (cardKept) cardKept.textContent = format(netKept);

        const rate = bonus > 0 ? (bonusTax / bonus) * 100 : 0;
        const descRate = root.querySelector<HTMLElement>('[data-desc-rate]');
        const descText = root.querySelector<HTMLElement>('[data-description]');
        if (descRate) descRate.textContent = formatPct(rate);
        if (descText) {
          descText.textContent = `Your bonus of ${format(bonus)} is taxed at a marginal rate of ${formatPct(rate)}. You'll pay ${format(bonusTax)} in income tax and ${format(bonusNi)} in National Insurance.`;
        }
      }

      let timer = 0;
      function schedule() {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => recalculate(), 150);
      }

      salaryInput?.addEventListener('input', schedule);
      bonusInput?.addEventListener('input', schedule);
      taxCodeInput?.addEventListener('input', schedule);
      pensionSlider?.addEventListener('input', schedule);

      recalculate();

      // PDF download wiring
      const pdfBtn = root.querySelector<HTMLElement>('[data-download-pdf]');
      pdfBtn?.classList.remove('hidden');
      pdfBtn?.addEventListener('click', async () => {
        const { generateBonusPDF } = await import('../utils/pdfExport.js');
        const salary = Math.max(parseFloat(salaryInput?.value || '0') || 0, 0);
        const bonus = Math.max(parseFloat(bonusInput?.value || '0') || 0, 0);
        const taxCode = taxCodeInput?.value || '1257L';
        const pensionPct = Math.min(Math.max(parseFloat(pensionSlider?.value || '0') || 0, 0), 20);
        const pa = parseTaxCode(taxCode);
        const pensionAmount = (salary * pensionPct) / 100;
        const salaryAfterPension = Math.max(salary - pensionAmount, 0);
        const taxableWithout = Math.max(salaryAfterPension - pa, 0);
        const taxableWith = Math.max(salaryAfterPension + bonus - pa, 0);
        const taxWithout = incomeTaxBands(taxableWithout);
        const taxWith = incomeTaxBands(taxableWith);
        const bonusTax = Math.max(taxWith - taxWithout, 0);
        const niWithout = calculateNI(salaryAfterPension);
        const niWith = calculateNI(salaryAfterPension + bonus);
        const bonusNi = Math.max(niWith - niWithout, 0);
        const pensionDeduction = (bonus * pensionPct) / 100;
        const netKept = Math.max(bonus - bonusTax - bonusNi - pensionDeduction, 0);
        const f = (n: number) => `\u00a3${Math.round(n).toLocaleString('en-GB')}`;
        generateBonusPDF({
          salary: f(salary), bonus: f(bonus), taxCode, pension: pensionPct + '%',
          grossBonus: f(bonus), tax: f(bonusTax), ni: f(bonusNi),
          pensionDeduction: f(pensionDeduction), netBonus: f(netKept), bonusRaw: bonus,
        });
      });
    });
  </script>
</Layout>
