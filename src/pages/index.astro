---
import Layout from '../layouts/Layout.astro';

const allCalcs = [
  { name: 'Salary Calculator', desc: 'Annual to monthly, weekly, daily take-home', href: '/salary-calculator', category: 'Pay & Income' },
  { name: 'Hourly Wage', desc: 'Convert hourly rate to salary', href: '/hourly-wage-calculator', category: 'Pay & Income' },
  { name: 'Pro-Rata Calculator', desc: 'Part-time and irregular hours', href: '/pro-rata-calculator', category: 'Pay & Income' },
  { name: 'Compare Salaries', desc: 'Side-by-side comparison', href: '/compare-salaries', category: 'Pay & Income' },
  { name: 'Salary Tables', desc: 'Tax bands and thresholds', href: '/salary-tables', category: 'Pay & Income' },
  { name: 'National Minimum Wage', desc: 'National Living Wage rates', href: '/national-minimum-wage', category: 'Pay & Income' },
  { name: 'Overtime Calculator', desc: 'Time and a half, double time', href: '/overtime-calculator', category: 'Pay & Income' },
  { name: 'Pay Rise Calculator', desc: 'Real take-home increase', href: '/pay-rise-calculator', category: 'Pay & Income' },
  { name: 'Bonus Calculator', desc: 'See how much of your bonus you keep', href: '/bonus-calculator', category: 'Pay & Income' },
  { name: 'Required Salary', desc: 'Work backwards from target take-home', href: '/required-salary', category: 'Pay & Income' },
  { name: 'Stamp Duty', desc: 'SDLT on your property purchase', href: '/stamp-duty-calculator', category: 'Property' },
  { name: 'Mortgage Affordability', desc: 'How much can you borrow?', href: '/mortgage-affordability', category: 'Property' },
  { name: 'Rental Yield', desc: 'Gross and net yield calculator', href: '/rental-yield', category: 'Property' },
  { name: 'Self-Employed Tax Calculator', desc: 'Income tax, Class 2 & 4 NICs', href: '/self-employed-tax-calculator', category: 'Self-Employed' },
  { name: 'Sick Pay Calculator', desc: 'Statutory sick pay with 2026 rules', href: '/sick-pay-calculator', category: 'Self-Employed' },
];

const categories = [
  { name: 'Pay & Income', desc: 'Salary, hourly wage, tax, NI, bonuses and pay rises' },
  { name: 'Property', desc: 'Stamp duty, mortgage affordability and rental yield' },
  { name: 'Self-Employed', desc: 'Tax, National Insurance and sick pay for sole traders' },
];

const qaCards = [
  {
    q: 'What is the take-home pay for £25,000?',
    a: 'Roughly £1,650–£1,700 per month after tax and NI (tax code 1257L, no pension or student loan).',
    href: '/salary/25000',
  },
  {
    q: 'What is the take-home pay for £30,000?',
    a: 'Roughly £1,970–£2,020 per month after tax and NI (tax code 1257L, no pension or student loan).',
    href: '/salary/30000',
  },
  {
    q: 'How much tax do I pay on £40,000?',
    a: 'Approximately £5,500 income tax and £3,200 National Insurance, leaving around £31,300 take-home per year.',
    href: '/salary/40000',
  },
  {
    q: 'What is £45,000 after tax?',
    a: 'Roughly £2,820–£2,880 per month after tax and NI (tax code 1257L). Assumes no pension contributions.',
    href: '/salary/45000',
  },
  {
    q: 'What is the National Living Wage 2026?',
    a: 'From April 2026, £12.71/hour for ages 21+. Ages 18–20 get £10.85, under 18 get £8.00, apprentices get £8.00.',
    href: '/national-minimum-wage',
  },
  {
    q: 'How much stamp duty on a £300,000 house?',
    a: 'First-time buyers pay £0 (relief covers up to £425,000). Home movers pay £3,500. Buy-to-let adds a 3% surcharge.',
    href: '/stamp-duty/300000',
  },
];

const faqItems = [
  {
    q: 'Are these calculations accurate?',
    a: 'Our calculators use the official 2026/27 HMRC tax rates, National Insurance thresholds, and student loan repayment thresholds. Results are accurate for standard tax codes (e.g., 1257L) but individual circumstances may vary. Always verify with HMRC or a qualified accountant.',
  },
  {
    q: 'What tax year do these calculators use?',
    a: 'All calculations use the 2026/27 tax year rates, which run from 6 April 2026 to 5 April 2027. We update our rates within 48 hours of any HMRC budget announcement.',
  },
  {
    q: 'Is my data stored or shared?',
    a: 'No. All calculations run entirely in your browser. We do not collect, store, or transmit your salary, tax code, or any personal information. See our Privacy Policy for full details.',
  },
  {
    q: 'What is tax code 1257L?',
    a: '1257L is the standard tax code for 2026/27. It means you get the full personal allowance of £12,570 before paying income tax. The \'L\' indicates you’re entitled to the standard tax-free amount.',
  },
  {
    q: 'How is National Insurance calculated?',
    a: 'For 2026/27, employees pay 8% on earnings between £12,570 and £50,270, and 2% on earnings above £50,270. These rates apply to Class 1 NI contributions deducted through PAYE.',
  },
  {
    q: 'Can I use this for self-employed or contractor calculations?',
    a: 'Our calculators are designed for PAYE employees. Self-employed tax works differently (Class 2 and 4 NI, payments on account). We recommend consulting an accountant for self-assessment calculations.',
  },
];
---

<Layout
  title="wagecheck | UK salary, tax and stamp duty calculators"
  description="Free UK salary, tax and stamp duty calculators with a clean fintech design."
>
  <!-- ═══════ HERO: ANIMATED CAROUSEL ═══════ -->
    <section class="relative overflow-hidden bg-gradient-to-br from-emerald-50 via-white to-lime-50 py-6 sm:py-8 lg:py-10" data-hero-carousel>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
          <div class="text-center lg:text-left">
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-700 hero-eyebrow mb-2 sm:mb-3" data-hero-eyebrow>Free UK calculators</p>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl leading-tight hero-title mt-1 sm:mt-2" data-hero-title>
              UK Salary &amp; Tax <span class="font-display italic text-emerald-600">Calculators</span>
            </h1>
            <p class="mx-auto max-w-xl text-sm text-slate-500 sm:text-base lg:mx-0 hero-subtitle mt-2 sm:mt-3" data-hero-subtitle>
              Find your take-home pay after tax, NI and pension. All calculators use 2026/27 HMRC rates.
            </p>
            <div class="flex flex-col items-center gap-2.5 sm:gap-3 mt-3 sm:mt-4 sm:flex-row lg:justify-start hero-cta-group">
              <a
                href="/salary-calculator/"
                class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
                data-hero-cta
              >
                Calculate →
              </a>
              <a
                href="#all-calculators"
                class="inline-flex items-center justify-center rounded-xl border border-emerald-200 bg-white px-6 py-2.5 text-sm font-semibold text-emerald-700 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50"
              >
                All Calculators
              </a>
            </div>
            <div class="mt-5 flex items-center justify-center gap-2 sm:mt-6 lg:justify-start" data-hero-dots>
              <button class="h-2 w-2 rounded-full bg-emerald-600 transition-colors" data-dot="0" aria-label="Slide 1"></button>
              <button class="h-2 w-2 rounded-full bg-slate-300 transition-colors" data-dot="1" aria-label="Slide 2"></button>
              <button class="h-2 w-2 rounded-full bg-slate-300 transition-colors" data-dot="2" aria-label="Slide 3"></button>
              <button class="h-2 w-2 rounded-full bg-slate-300 transition-colors" data-dot="3" aria-label="Slide 4"></button>
            </div>
          </div>
          <div class="relative hidden items-center justify-center md:flex self-center">
            <img
              src="/calculator-glass.png"
              alt=""
              width="480"
              height="480"
              loading="eager"
              decoding="async"
              class="h-auto w-full max-w-[260px] lg:max-w-[300px]"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ ACCURACY BADGE ═══════ -->
    <section class="border-b border-emerald-100 bg-emerald-50/40 py-3">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 trust-badge">
          <span class="trust-badge-item font-medium text-emerald-700">2026/27 HMRC rates</span>
          <span class="trust-badge-item">No data stored</span>
          <span class="trust-badge-item">All calculations run in your browser</span>
        </div>
      </div>
    </section>

  <!-- ═══════ POPULAR CALCULATORS ═══════ -->
  <section class="bg-white py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-slate-900 mb-2">Popular Calculators</h2>
      <p class="text-sm text-slate-500 mb-6">The calculators most visitors start with</p>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        <a href="/salary-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20m5-17H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Salary Calculator</p>
          <p class="mt-1 text-xs text-slate-500">Take-Home Pay</p>
        </a>
        <a href="/hourly-wage-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Hourly Wage</p>
          <p class="mt-1 text-xs text-slate-500">Hourly ↔ Salary</p>
        </a>
        <a href="/national-minimum-wage/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Minimum Wage</p>
          <p class="mt-1 text-xs text-slate-500">2026 Rates</p>
        </a>
        <a href="/stamp-duty-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Stamp Duty</p>
          <p class="mt-1 text-xs text-slate-500">Property Tax</p>
        </a>
        <a href="/self-employed-tax-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Self-Employed Tax</p>
          <p class="mt-1 text-xs text-slate-500">Sole Trader</p>
        </a>
        <a href="/pro-rata-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Pro-Rata Calculator</p>
          <p class="mt-1 text-xs text-slate-500">Part-Time Pay</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ ALL CALCULATORS (GROUPED BY CATEGORY) ═══════ -->
  <section id="all-calculators" class="bg-slate-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">All Calculators</h2>
      <p class="text-sm text-slate-500 mb-10">Every calculator on wagecheck, grouped by topic</p>

      {categories.map((cat) => (
        <div class="mb-10 last:mb-0">
          <h3 class="text-sm font-semibold uppercase tracking-widest text-emerald-700 mb-4">{cat.name}</h3>
          <p class="text-sm text-slate-500 mb-5">{cat.desc}</p>
          <div class="animate-on-scroll grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {allCalcs.filter((c) => c.category === cat.name).map((card) => (
              <a
                href={card.href}
                class="group calc-card block rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md"
              >
                <div class="flex items-start justify-between">
                  <h3 class="text-lg font-bold text-slate-900">{card.name}</h3>
                  <svg class="h-5 w-5 shrink-0 text-emerald-400 transition-transform group-hover:translate-x-0.5 group-hover:text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </svg>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-slate-500">{card.desc}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════ COMMON QUESTIONS ═══════ -->
  <section id="common-questions" class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 mb-2">Common Questions</h2>
      <p class="text-slate-500 mb-10">Quick answers to the UK's most searched salary and tax questions</p>

      <div class="animate-on-scroll grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {qaCards.map((card) => (
          <div class="qa-card rounded-xl border border-slate-100 bg-slate-50 p-5">
            <h3 class="text-base font-semibold text-slate-900">{card.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{card.a}</p>
            <a
              href={card.href}
              class="mt-3 inline-block text-sm font-medium text-emerald-600 hover:underline"
            >
              Check →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ FAQ ═══════ -->
  <section id="faq" class="bg-slate-50/60 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Frequently Asked Questions</h2>
      <p class="text-slate-500 mb-8">Common questions about UK tax, National Insurance and our calculators</p>
      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="faq-item group rounded-xl border border-slate-100 bg-white" open>
            <summary class="flex cursor-pointer list-none items-center justify-between p-5 text-base font-semibold text-slate-900 hover:bg-slate-50 transition-colors [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-answer">
              <div class="faq-answer-inner px-5 pb-5 text-sm leading-relaxed text-slate-600">
                {item.a}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    const slides = [
      { title: 'Salary Calculator 2026/27', subtitle: 'Calculate your exact take-home pay, tax, NI and pension.', cta: 'Calculate', href: '/salary-calculator/' },
      { title: 'Hourly Wage Calculator', subtitle: 'Convert hourly to salary or annual to hourly rate.', cta: 'Convert', href: '/hourly-wage-calculator/' },
      { title: 'National Minimum Wage', subtitle: 'Check 2026/27 rates by age and see your take-home pay.', cta: 'Check Rates', href: '/national-minimum-wage/' },
      { title: 'Self-Employed Tax Calculator', subtitle: 'Work out income tax, Class 2 & 4 NICs for 2026/27.', cta: 'Calculate Tax', href: '/self-employed-tax-calculator/' },
    ];

    const root = document.querySelector('[data-hero-carousel]');
    if (root) {
      const eyebrowEl = root.querySelector<HTMLElement>('[data-hero-eyebrow]');
      const titleEl = root.querySelector<HTMLElement>('[data-hero-title]');
      const subtitleEl = root.querySelector<HTMLElement>('[data-hero-subtitle]');
      const ctaEl = root.querySelector<HTMLAnchorElement>('[data-hero-cta]');
      const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
      let current = 0;
      let paused = false;
      let interval: ReturnType<typeof setInterval>;

      function goTo(index: number) {
        current = index;
        const s = slides[current];
        if (eyebrowEl) {
          const eyebrows = [
            'Free UK calculators',
            'Hourly & salary',
            '2026 rates',
            'Self-employed tax',
          ];
          eyebrowEl.textContent = eyebrows[current];
        }
        if (titleEl) titleEl.textContent = s.title;
        if (subtitleEl) subtitleEl.textContent = s.subtitle;
        if (ctaEl) {
          ctaEl.textContent = `${s.cta} →`;
          ctaEl.href = s.href;
        }
        dots.forEach((d, i) => {
          d.classList.toggle('bg-emerald-600', i === current);
          d.classList.toggle('bg-slate-300', i !== current);
        });
      }

      function next() { goTo((current + 1) % slides.length); }

      function start() {
        stop();
        interval = setInterval(() => { if (!paused) next(); }, 5000);
      }
      function stop() { clearInterval(interval); }

      dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); start(); }));
      root.addEventListener('mouseenter', () => { paused = true; });
      root.addEventListener('mouseleave', () => { paused = false; });

      start();
    }
  </script>
</Layout>
