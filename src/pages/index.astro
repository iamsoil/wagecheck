---
import Layout from '../layouts/Layout.astro';

const allCalcs = [
  { name: 'Salary Calculator', desc: 'Annual to monthly, weekly, daily take-home', href: '/salary-calculator' },
  { name: 'Hourly Wage', desc: 'Convert hourly rate to salary', href: '/hourly-wage-calculator' },
  { name: 'Pro-Rata Calculator', desc: 'Part-time and irregular hours', href: '/pro-rata-calculator' },
  { name: 'Stamp Duty', desc: 'SDLT on your property purchase', href: '/stamp-duty-calculator' },
  { name: 'Required Salary', desc: 'Work backwards from target take-home', href: '/required-salary' },
  { name: 'Compare Salaries', desc: 'Side-by-side comparison', href: '/compare-salaries' },
  { name: 'Salary Tables', desc: 'Tax bands and thresholds', href: '/salary-tables' },
  { name: 'National Minimum Wage', desc: 'National Living Wage rates', href: '/national-minimum-wage' },
  { name: 'Rental Yield', desc: 'Gross and net yield calculator', href: '/rental-yield' },
  { name: 'Bonus Calculator', desc: 'See how much of your bonus you keep', href: '/bonus-calculator' },
  { name: 'Pay Rise Calculator', desc: 'Real take-home increase', href: '/pay-rise-calculator' },
  { name: 'Overtime Calculator', desc: 'Time and a half, double time', href: '/overtime-calculator' },
  { name: 'Mortgage Affordability', desc: 'How much can you borrow?', href: '/mortgage-affordability' },
  { name: 'Sick Pay Calculator', desc: 'Statutory sick pay with 2026 rules', href: '/sick-pay-calculator' },
  { name: 'Self-Employed Tax Calculator', desc: 'Income tax, Class 2 & 4 NICs', href: '/self-employed-tax-calculator' },
];

const qaCards = [
  {
    q: 'What is the take-home pay for \u00a325,000?',
    a: 'For the 2026/27 tax year, a \u00a325,000 salary gives roughly \u00a31,650\u2013\u00a31,700 per month after tax and NI (tax code 1257L, no pension or student loan).',
    href: '/salary/25000',
  },
  {
    q: 'What is the take-home pay for \u00a330,000?',
    a: 'For the 2026/27 tax year, a \u00a330,000 salary gives roughly \u00a31,970\u2013\u00a32,020 per month after tax and NI (tax code 1257L, no pension or student loan).',
    href: '/salary/30000',
  },
  {
    q: 'How much tax do I pay on \u00a340,000?',
    a: 'On \u00a340,000 you pay approximately \u00a35,500 in income tax and \u00a33,200 in National Insurance, leaving a take-home of around \u00a331,300 per year.',
    href: '/salary/40000',
  },
  {
    q: 'What is \u00a345,000 after tax?',
    a: 'A \u00a345,000 salary in 2026/27 gives roughly \u00a32,820\u2013\u00a32,880 per month after tax and NI (tax code 1257L). This assumes no pension contributions.',
    href: '/salary/45000',
  },
  {
    q: 'How much tax do I pay on \u00a350,000?',
    a: 'On \u00a350,000 you pay approximately \u00a37,400 in income tax and \u00a33,900 in National Insurance, leaving a take-home of around \u00a338,700 per year.',
    href: '/salary/50000',
  },
  {
    q: 'What is \u00a360,000 after tax?',
    a: 'A \u00a360,000 salary pays around \u00a312,400 in income tax and \u00a34,000 in NI for 2026/27, leaving roughly \u00a33,600 per month take-home (no pension or student loan).',
    href: '/salary/60000',
  },
  {
    q: 'What is \u00a3100,000 after tax?',
    a: 'A \u00a3100,000 salary faces personal allowance tapering above \u00a3100,000. After tax and NI you take home roughly \u00a35,300\u2013\u00a35,400 per month for 2026/27.',
    href: '/salary/100000',
  },
  {
    q: 'What is the National Living Wage 2026?',
    a: 'From April 2026, the National Living Wage for workers aged 21+ is \u00a312.71 per hour. Ages 18\u201320 get \u00a310.85, under 18 get \u00a38.00, and apprentices get \u00a38.00.',
    href: '/national-minimum-wage',
  },
  {
    q: 'How much stamp duty on a \u00a3300,000 house?',
    a: 'First-time buyers pay \u00a30 on a \u00a3300,000 property (relief covers up to \u00a3425,000). Home movers pay \u00a33,500. Buy-to-let or second homes add a 3% surcharge.',
    href: '/stamp-duty/300000',
  },
  {
    q: 'What is \u00a315 per hour annually?',
    a: '\u00a315 per hour at 37.5 hours/week is \u00a329,250 per year gross. After tax and NI, your take-home is approximately \u00a323,500\u2013\u00a324,000.',
    href: '/hourly-wage-calculator',
  },
];

const faqItems = [
  {
    q: 'Are these calculations accurate?',
    a: 'Our calculators use the official 2026/27 HMRC tax rates, National Insurance thresholds, and student loan repayment thresholds. Results are accurate for standard tax codes (e.g., 1257L) but individual circumstances may vary. Always verify with HMRC or a qualified accountant.',
  },
  {
    q: 'What tax year do these calculators use?',
    a: 'All calculations use the 2026/27 tax year rates, which run from 6 April 2026 to 5 April 2027. We update our rates within 48 hours of any HMRC budget announcement.',
  },
  {
    q: 'Is my data stored or shared?',
    a: 'No. All calculations run entirely in your browser. We do not collect, store, or transmit your salary, tax code, or any personal information. See our Privacy Policy for full details.',
  },
  {
    q: 'What is tax code 1257L?',
    a: '1257L is the standard tax code for 2026/27. It means you get the full personal allowance of \u00a312,570 before paying income tax. The \'L\' indicates you\u2019re entitled to the standard tax-free amount.',
  },
  {
    q: 'How is National Insurance calculated?',
    a: 'For 2026/27, employees pay 8% on earnings between \u00a312,570 and \u00a350,270, and 2% on earnings above \u00a350,270. These rates apply to Class 1 NI contributions deducted through PAYE.',
  },
  {
    q: 'Can I use this for self-employed or contractor calculations?',
    a: 'Our calculators are designed for PAYE employees. Self-employed tax works differently (Class 2 and 4 NI, payments on account). We recommend consulting an accountant for self-assessment calculations.',
  },
];
---

<Layout
  title="wagecheck | UK salary, tax and stamp duty calculators"
  description="Free UK salary, tax and stamp duty calculators with a clean fintech design."
>
  <!-- ═══════ HERO: 3-CARD GRID ═══════ -->
  <section class="bg-gradient-to-b from-emerald-50/50 to-white py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Free UK Salary, Tax &amp; Stamp Duty <span class="font-display italic text-emerald-600">Calculators</span>
        </h1>
        <p class="mt-4 text-lg text-slate-500">17 accurate calculators for 2026/27. Clean, fast, and mobile-friendly.</p>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Card 1: Salary Calculator -->
        <a href="/salary-calculator/" class="group relative overflow-hidden rounded-2xl border-2 border-emerald-200 bg-white p-6 shadow-sm transition hover:border-emerald-400 hover:shadow-md sm:p-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100">
            <svg class="h-6 w-6 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20m5-17H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <h2 class="mt-4 text-xl font-bold text-slate-900">Salary Calculator</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">Calculate your exact take-home pay, income tax, National Insurance, pension and student loans.</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-600 transition group-hover:gap-2.5">
            Calculate Take-Home <span aria-hidden="true">&rarr;</span>
          </span>
        </a>

        <!-- Card 2: Hourly Wage Calculator -->
        <a href="/hourly-wage-calculator/" class="group relative overflow-hidden rounded-2xl border-2 border-blue-200 bg-white p-6 shadow-sm transition hover:border-blue-400 hover:shadow-md sm:p-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100">
            <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h2 class="mt-4 text-xl font-bold text-slate-900">Hourly Wage Calculator</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">Convert hourly rate to annual salary or annual salary to hourly rate. See take-home pay for any wage.</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 transition group-hover:gap-2.5">
            Convert Wage <span aria-hidden="true">&rarr;</span>
          </span>
        </a>

        <!-- Card 3: National Minimum Wage -->
        <a href="/national-minimum-wage/" class="group relative overflow-hidden rounded-2xl border-2 border-slate-200 bg-white p-6 shadow-sm transition hover:border-slate-400 hover:shadow-md sm:p-8">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100">
            <svg class="h-6 w-6 text-slate-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h2 class="mt-4 text-xl font-bold text-slate-900">National Minimum Wage 2026</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">Check minimum wage rates by age, see weekly and monthly take-home pay, and understand your rights.</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 transition group-hover:gap-2.5">
            Check Rates <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </div>

      <p class="mt-8 text-center">
        <a href="#all-calculators" class="text-sm font-medium text-emerald-600 hover:underline">Explore all 17 calculators &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ═══════ ALL CALCULATORS ═══════ -->
  <section id="all-calculators" class="bg-slate-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">All Calculators</h2>
      <div class="animate-on-scroll grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {allCalcs.map((card) => (
          <a
            href={card.href}
            class="calc-card block rounded-2xl border border-slate-100 bg-white p-6"
          >
            <h3 class="text-xl font-bold text-slate-900">{card.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{card.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ MOST SEARCHED UK ANSWERS ═══════ -->
  <section id="most-searched" class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Most Searched UK Answers</h2>
      <p class="text-slate-500 mb-8">Quick answers to the UK's most common salary and tax questions</p>
      <div class="animate-on-scroll grid gap-4 md:grid-cols-2">
        {qaCards.map((card) => (
          <div class="qa-card rounded-xl border border-slate-100 bg-slate-50 p-5">
            <h3 class="text-lg font-semibold text-slate-900">{card.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{card.a}</p>
            <a
              href={card.href}
              class="mt-3 inline-block text-sm font-medium text-emerald-600 hover:underline"
            >
              Check &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ FAQ ═══════ -->
  <section class="bg-slate-50/60 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Frequently Asked Questions</h2>
      <p class="text-slate-500 mb-8">Common questions about UK tax, National Insurance and our calculators</p>
      <div class="animate-on-scroll space-y-3">
        {faqItems.map((item) => (
          <details class="faq-item rounded-xl border border-slate-100 bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between p-5 text-base font-semibold text-slate-900 hover:bg-slate-50 transition-colors [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-answer">
              <div class="faq-answer-inner px-5 pb-5 text-sm leading-relaxed text-slate-600">
                {item.a}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
