---
import Layout from '../layouts/Layout.astro';

const allCalcs = [
  { name: 'Salary Calculator', desc: 'Annual to monthly, weekly, daily take-home', href: '/salary-calculator' },
  { name: 'Hourly Wage', desc: 'Convert hourly rate to salary', href: '/hourly-wage-calculator' },
  { name: 'Pro-Rata Calculator', desc: 'Part-time and irregular hours', href: '/pro-rata-calculator' },
  { name: 'Stamp Duty', desc: 'SDLT on your property purchase', href: '/stamp-duty-calculator' },
  { name: 'Required Salary', desc: 'Work backwards from target take-home', href: '/required-salary' },
  { name: 'Compare Salaries', desc: 'Side-by-side comparison', href: '/compare-salaries' },
  { name: 'Salary Tables', desc: 'Tax bands and thresholds', href: '/salary-tables' },
  { name: 'National Minimum Wage', desc: 'National Living Wage rates', href: '/national-minimum-wage' },
  { name: 'Rental Yield', desc: 'Gross and net yield calculator', href: '/rental-yield' },
  { name: 'Bonus Calculator', desc: 'See how much of your bonus you keep', href: '/bonus-calculator' },
  { name: 'Pay Rise Calculator', desc: 'Real take-home increase', href: '/pay-rise-calculator' },
  { name: 'Overtime Calculator', desc: 'Time and a half, double time', href: '/overtime-calculator' },
  { name: 'Mortgage Affordability', desc: 'How much can you borrow?', href: '/mortgage-affordability' },
  { name: 'Sick Pay Calculator', desc: 'Statutory sick pay with 2026 rules', href: '/sick-pay-calculator' },
  { name: 'Self-Employed Tax Calculator', desc: 'Income tax, Class 2 & 4 NICs', href: '/self-employed-tax-calculator' },
];

const qaCards = [
  {
    q: 'What is the take-home pay for \u00a325,000?',
    a: 'For the 2026/27 tax year, a \u00a325,000 salary gives roughly \u00a31,650\u2013\u00a31,700 per month after tax and NI (tax code 1257L, no pension or student loan).',
    href: '/salary/25000',
  },
  {
    q: 'What is the take-home pay for \u00a330,000?',
    a: 'For the 2026/27 tax year, a \u00a330,000 salary gives roughly \u00a31,970\u2013\u00a32,020 per month after tax and NI (tax code 1257L, no pension or student loan).',
    href: '/salary/30000',
  },
  {
    q: 'How much tax do I pay on \u00a340,000?',
    a: 'On \u00a340,000 you pay approximately \u00a35,500 in income tax and \u00a33,200 in National Insurance, leaving a take-home of around \u00a331,300 per year.',
    href: '/salary/40000',
  },
  {
    q: 'What is \u00a345,000 after tax?',
    a: 'A \u00a345,000 salary in 2026/27 gives roughly \u00a32,820\u2013\u00a32,880 per month after tax and NI (tax code 1257L). This assumes no pension contributions.',
    href: '/salary/45000',
  },
  {
    q: 'How much tax do I pay on \u00a350,000?',
    a: 'On \u00a350,000 you pay approximately \u00a37,400 in income tax and \u00a33,900 in National Insurance, leaving a take-home of around \u00a338,700 per year.',
    href: '/salary/50000',
  },
  {
    q: 'What is \u00a360,000 after tax?',
    a: 'A \u00a360,000 salary pays around \u00a312,400 in income tax and \u00a34,000 in NI for 2026/27, leaving roughly \u00a33,600 per month take-home (no pension or student loan).',
    href: '/salary/60000',
  },
  {
    q: 'What is \u00a3100,000 after tax?',
    a: 'A \u00a3100,000 salary faces personal allowance tapering above \u00a3100,000. After tax and NI you take home roughly \u00a35,300\u2013\u00a35,400 per month for 2026/27.',
    href: '/salary/100000',
  },
  {
    q: 'What is the National Living Wage 2026?',
    a: 'From April 2026, the National Living Wage for workers aged 21+ is \u00a312.71 per hour. Ages 18\u201320 get \u00a310.85, under 18 get \u00a38.00, and apprentices get \u00a38.00.',
    href: '/national-minimum-wage',
  },
  {
    q: 'How much stamp duty on a \u00a3300,000 house?',
    a: 'First-time buyers pay \u00a30 on a \u00a3300,000 property (relief covers up to \u00a3425,000). Home movers pay \u00a33,500. Buy-to-let or second homes add a 3% surcharge.',
    href: '/stamp-duty/300000',
  },
  {
    q: 'What is \u00a315 per hour annually?',
    a: '\u00a315 per hour at 37.5 hours/week is \u00a329,250 per year gross. After tax and NI, your take-home is approximately \u00a323,500\u2013\u00a324,000.',
    href: '/hourly-wage-calculator',
  },
];

const faqItems = [
  {
    q: 'Are these calculations accurate?',
    a: 'Our calculators use the official 2026/27 HMRC tax rates, National Insurance thresholds, and student loan repayment thresholds. Results are accurate for standard tax codes (e.g., 1257L) but individual circumstances may vary. Always verify with HMRC or a qualified accountant.',
  },
  {
    q: 'What tax year do these calculators use?',
    a: 'All calculations use the 2026/27 tax year rates, which run from 6 April 2026 to 5 April 2027. We update our rates within 48 hours of any HMRC budget announcement.',
  },
  {
    q: 'Is my data stored or shared?',
    a: 'No. All calculations run entirely in your browser. We do not collect, store, or transmit your salary, tax code, or any personal information. See our Privacy Policy for full details.',
  },
  {
    q: 'What is tax code 1257L?',
    a: '1257L is the standard tax code for 2026/27. It means you get the full personal allowance of \u00a312,570 before paying income tax. The \'L\' indicates you\u2019re entitled to the standard tax-free amount.',
  },
  {
    q: 'How is National Insurance calculated?',
    a: 'For 2026/27, employees pay 8% on earnings between \u00a312,570 and \u00a350,270, and 2% on earnings above \u00a350,270. These rates apply to Class 1 NI contributions deducted through PAYE.',
  },
  {
    q: 'Can I use this for self-employed or contractor calculations?',
    a: 'Our calculators are designed for PAYE employees. Self-employed tax works differently (Class 2 and 4 NI, payments on account). We recommend consulting an accountant for self-assessment calculations.',
  },
];
---

<Layout
  title="wagecheck | UK salary, tax and stamp duty calculators"
  description="Free UK salary, tax and stamp duty calculators with a clean fintech design."
>
  <!-- ═══════ HERO: ANIMATED CAROUSEL ═══════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-emerald-50/50 to-white py-8 sm:py-10 lg:py-12" data-hero-carousel>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div class="text-center lg:text-left">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-600">Free UK calculators</p>
          <div class="relative mt-3 h-[100px] sm:h-[90px] lg:h-[80px]">
            <h1 class="absolute inset-0 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl">
              UK Salary &amp; Tax <span class="font-display italic text-emerald-600" data-hero-title>Calculators</span>
            </h1>
          </div>
          <p class="mx-auto mt-1 max-w-xl text-sm text-slate-500 sm:text-base lg:mx-0" data-hero-subtitle>
            17 accurate calculators for 2026/27. Clean, fast, and mobile-friendly.
          </p>
          <div class="mt-4 flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
            <a
              href="/salary-calculator/"
              class="inline-flex items-center justify-center rounded-lg bg-emerald-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
              data-hero-cta
            >
              Calculate &rarr;
            </a>
            <a
              href="#all-calculators"
              class="inline-flex items-center justify-center rounded-lg border border-emerald-200 bg-white px-6 py-2.5 text-sm font-semibold text-emerald-700 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50"
            >
              View All Calculators
            </a>
          </div>
          <div class="mt-5 flex items-center justify-center gap-2 lg:justify-start" data-hero-dots>
            <button class="h-2 w-2 rounded-full bg-emerald-600 transition-colors" data-dot="0" aria-label="Slide 1"></button>
            <button class="h-2 w-2 rounded-full bg-slate-300 transition-colors" data-dot="1" aria-label="Slide 2"></button>
            <button class="h-2 w-2 rounded-full bg-slate-300 transition-colors" data-dot="2" aria-label="Slide 3"></button>
            <button class="h-2 w-2 rounded-full bg-slate-300 transition-colors" data-dot="3" aria-label="Slide 4"></button>
          </div>
        </div>
        <div class="relative hidden items-center justify-center md:flex">
          <img
            src="/calculator-glass.png"
            alt=""
            width="480"
            height="480"
            loading="eager"
            decoding="async"
            class="h-auto w-full max-w-[260px] lg:max-w-[300px]"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════ POPULAR CALCULATORS ═══════ -->
  <section class="bg-white py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Popular Calculators</h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-6">
        <a href="/salary-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20m5-17H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Salary Calculator</p>
          <p class="mt-1 text-xs text-slate-500">Take-Home Pay</p>
        </a>
        <a href="/hourly-wage-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Hourly Wage</p>
          <p class="mt-1 text-xs text-slate-500">Hourly &harr; Salary</p>
        </a>
        <a href="/national-minimum-wage/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Minimum Wage</p>
          <p class="mt-1 text-xs text-slate-500">2026 Rates</p>
        </a>
        <a href="/stamp-duty-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Stamp Duty</p>
          <p class="mt-1 text-xs text-slate-500">Property Tax</p>
        </a>
        <a href="/self-employed-tax-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Self-Employed Tax</p>
          <p class="mt-1 text-xs text-slate-500">Sole Trader</p>
        </a>
        <a href="/pro-rata-calculator/" class="group flex flex-col items-center rounded-xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
          <svg class="h-8 w-8 text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
          <p class="mt-3 text-sm font-semibold text-slate-900">Pro-Rata Calculator</p>
          <p class="mt-1 text-xs text-slate-500">Part-Time Pay</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════ ALL CALCULATORS ═══════ -->
  <section id="all-calculators" class="bg-slate-50/60 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">All Calculators</h2>
      <div class="animate-on-scroll grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {allCalcs.map((card) => (
          <a
            href={card.href}
            class="calc-card block rounded-2xl border border-slate-100 bg-white p-6"
          >
            <h3 class="text-xl font-bold text-slate-900">{card.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{card.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ MOST SEARCHED UK ANSWERS ═══════ -->
  <section id="most-searched" class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Most Searched UK Answers</h2>
      <p class="text-slate-500 mb-8">Quick answers to the UK's most common salary and tax questions</p>
      <div class="animate-on-scroll grid gap-4 md:grid-cols-2">
        {qaCards.map((card) => (
          <div class="qa-card rounded-xl border border-slate-100 bg-slate-50 p-5">
            <h3 class="text-lg font-semibold text-slate-900">{card.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{card.a}</p>
            <a
              href={card.href}
              class="mt-3 inline-block text-sm font-medium text-emerald-600 hover:underline"
            >
              Check &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════ FAQ ═══════ -->
  <section class="bg-slate-50/60 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Frequently Asked Questions</h2>
      <p class="text-slate-500 mb-8">Common questions about UK tax, National Insurance and our calculators</p>
      <div class="animate-on-scroll space-y-3">
        {faqItems.map((item) => (
          <details class="faq-item rounded-xl border border-slate-100 bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between p-5 text-base font-semibold text-slate-900 hover:bg-slate-50 transition-colors [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="faq-answer">
              <div class="faq-answer-inner px-5 pb-5 text-sm leading-relaxed text-slate-600">
                {item.a}
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    const slides = [
      { title: 'Salary Calculator 2026/27', subtitle: 'Calculate your exact take-home pay, tax, NI and pension.', cta: 'Calculate \u2192', href: '/salary-calculator/' },
      { title: 'Hourly Wage Calculator', subtitle: 'Convert hourly to salary or annual to hourly rate.', cta: 'Convert \u2192', href: '/hourly-wage-calculator/' },
      { title: 'National Minimum Wage', subtitle: 'Check 2026/27 rates by age and see your take-home pay.', cta: 'Check Rates \u2192', href: '/national-minimum-wage/' },
      { title: 'Self-Employed Tax Calculator', subtitle: 'Work out income tax, Class 2 & 4 NICs for 2026/27.', cta: 'Calculate Tax \u2192', href: '/self-employed-tax-calculator/' },
    ];

    const root = document.querySelector('[data-hero-carousel]');
    if (root) {
      const titleEl = root.querySelector<HTMLElement>('[data-hero-title]');
      const subtitleEl = root.querySelector<HTMLElement>('[data-hero-subtitle]');
      const ctaEl = root.querySelector<HTMLAnchorElement>('[data-hero-cta]');
      const dots = root.querySelectorAll<HTMLElement>('[data-dot]');
      let current = 0;
      let paused = false;
      let interval: ReturnType<typeof setInterval>;

      function goTo(index: number) {
        current = index;
        const s = slides[current];
        if (titleEl) titleEl.textContent = s.title;
        if (subtitleEl) subtitleEl.textContent = s.subtitle;
        if (ctaEl) { ctaEl.textContent = s.cta; ctaEl.href = s.href; }
        dots.forEach((d, i) => {
          d.classList.toggle('bg-emerald-600', i === current);
          d.classList.toggle('bg-slate-300', i !== current);
        });
      }

      function next() { goTo((current + 1) % slides.length); }

      function start() {
        stop();
        interval = setInterval(() => { if (!paused) next(); }, 5000);
      }
      function stop() { clearInterval(interval); }

      dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); start(); }));
      root.addEventListener('mouseenter', () => { paused = true; });
      root.addEventListener('mouseleave', () => { paused = false; });

      start();
    }
  </script>
</Layout>
