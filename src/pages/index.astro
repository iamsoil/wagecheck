<---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CalculatorCard from '../components/CalculatorCard.astro';

const calculatorCards = [
  {
    title: 'Take-Home Pay Calculator',
    description: 'Calculate your net salary after tax and National Insurance.',
    href: '/salary-calculator',
    icon: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a1 1 0 0 1 1 1v1.07a7.004 7.004 0 0 1 5.93 5.93H20a1 1 0 1 1 0 2h-1.07a7.004 7.004 0 0 1-5.93 5.93V20a1 1 0 1 1-2 0v-1.07a7.004 7.004 0 0 1-5.93-5.93H4a1 1 0 1 1 0-2h1.07a7.004 7.004 0 0 1 5.93-5.93V3a1 1 0 0 1 1-1Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" /></svg>',
  },
  {
    title: 'Stamp Duty Calculator',
    description: 'Estimate stamp duty land tax on UK property purchases.',
    href: '/stamp-duty-calculator',
    icon: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8.5a1 1 0 0 0-.293-.707l-4.5-4.5A1 1 0 0 0 15.5 3H4Zm11 1.5V8h3.5L15 4.5ZM7 12a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2H8a1 1 0 0 1-1-1Zm0 4a1 1 0 0 1 1-1h8a1 1 0 1 1 0 2H8a1 1 0 0 1-1-1Z" /></svg>',
  },
  {
    title: 'Rental Yield Calculator',
    description: 'Calculate rental yield for property investments.',
    href: '/rental-yield',
    icon: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.25a.75.75 0 0 1 .53.22l8.25 8.25A.75.75 0 0 1 21.25 12H20v8a1 1 0 0 1-1 1h-4.75a.75.75 0 0 1-.75-.75V16a1.75 1.75 0 0 0-3.5 0v4.25a.75.75 0 0 1-.75.75H4a1 1 0 0 1-1-1v-8H1.75a.75.75 0 0 1-.53-1.28l8.25-8.25a.75.75 0 0 1 .53-.22Z" /></svg>',
    badge: 'Coming soon',
  },
];
--->
<Layout
  title="wagecheck | UK salary, tax and stamp duty calculators"
  description="Free UK salary, tax and stamp duty calculators with a clean fintech design."
>
  <HeroSection />
  <section class="bg-[#f8fafc]">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Popular calculators</h2>
        <p class="mt-3 text-base leading-7 text-slate-600">Start with the tools people use most often. Each calculator is designed to be fast, clear, and easy to trust.</p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {calculatorCards.map((card) => (
          <CalculatorCard {...card} />
        ))}
      </div>
    </div>
  </section>
</Layout>