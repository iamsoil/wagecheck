  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AggregateRating",
    "itemReviewed": {
      "@type": "WebApplication",
      "name": "Pro-Rata Calculator"
    },
    "ratingValue": "4.8",
    "reviewCount": "2400",
    "bestRating": "5"
  })} />

  <script>
    import { calculateTakeHomePay } from '../lib/calculations';
    import { renderTakeHomeResults, setNum, money as moneyFmt } from '../lib/takeHomeResults';

    const STATUTORY_HOLIDAY_DAYS = 28;

    document.querySelectorAll<HTMLElement>('[data-pro-rata-calculator]').forEach((root) => {
      const state = {
        mode: 'hours' as 'hours' | 'days',
        ftSalary: parseFloat(root.dataset.initialFtSalary || '30000'),
        ft: parseFloat(root.dataset.initialFt || '37.5'),
        actual: parseFloat(root.dataset.initialActual || '20'),
        pension: parseFloat(root.dataset.initialPension || '5'),
        loan: (root.dataset.initialLoan || 'none') as 'none' | 'plan1' | 'plan2' | 'plan4' | 'plan5' | 'postgraduate',
        region: (root.dataset.initialRegion || 'rest-of-uk') as 'rest-of-uk' | 'scotland',
      };

      const setToggle = (attribute: string, value: string) => {
        root.querySelectorAll<HTMLButtonElement>(`[${attribute}]`).forEach((btn) => {
          const isActive = btn.getAttribute(attribute) === value;
          btn.classList.toggle('bg-emerald-600', isActive);
          btn.classList.toggle('text-white', isActive);
          btn.classList.toggle('text-slate-600', !isActive);
          btn.classList.toggle('hover:text-emerald-600', !isActive);
        });
      };

      function recompute() {
        const gross = (state.ftSalary / state.ft) * state.actual;
        const holiday = (state.actual / state.ft) * STATUTORY_HOLIDAY_DAYS;
        const result = calculateTakeHomePay({
          grossAnnualSalary: gross,
          pensionContributionPercent: state.pension,
          studentLoanPlan: state.loan,
          region: state.region,
          taxCode: '1257L',
        });

        const formula = root.querySelector<HTMLElement>('[data-prorata-formula]');
        if (formula) {
          const unit = state.mode === 'hours' ? 'hrs' : 'days';
          formula.textContent = `(£${moneyFmt(state.ftSalary)} ÷ ${state.ft} ${unit}) × ${state.actual} ${unit}`;
        }

        setNum(root, 'holiday', holiday);
        renderTakeHomeResults(root, result, 'Wagecheck Pro-Rata Calculator (2026/27)', [
          { label: 'Full-time salary', value: moneyFmt(state.ftSalary) },
          { label: state.mode === 'hours' ? 'Full-time hours' : 'Full-time days', value: `${state.ft}` },
          { label: state.mode === 'hours' ? 'Your hours' : 'Your days', value: `${state.actual}` },
          { label: 'Holiday entitlement', value: `${holiday.toFixed(1)} days` },
        ]);
      }

      let timer = 0;
      function schedule() {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => recompute(), 150);
      }

      function setMode(mode: 'hours' | 'days') {
        state.mode = mode;
        const ftLabel = root.querySelector<HTMLElement>('[data-ft-label]');
        const actualLabel = root.querySelector<HTMLElement>('[data-actual-label]');
        if (ftLabel) ftLabel.textContent = mode === 'hours' ? 'Full-time hours per week' : 'Full-time days per week';
        if (actualLabel) actualLabel.textContent = mode === 'hours' ? 'Your hours per week' : 'Your days per week';

        const ftDefault = mode === 'hours' ? 37.5 : 5;
        const actualDefault = mode === 'hours' ? 20 : 3;
        state.ft = ftDefault;
        state.actual = actualDefault;
        const ftInput = root.querySelector<HTMLInputElement>('[data-ft]');
        if (ftInput) ftInput.value = String(ftDefault);
        const actualInput = root.querySelector<HTMLInputElement>('[data-actual]');
        if (actualInput) actualInput.value = String(actualDefault);

        setToggle('data-mode', mode);
        recompute();
      }

      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) => {
        btn.addEventListener('click', () => {
          setMode((btn.dataset.mode ?? 'hours') as 'hours' | 'days');
        });
      });

      const ftSalaryInput = root.querySelector<HTMLInputElement>('[data-ft-salary]');
      ftSalaryInput?.addEventListener('input', () => {
        const raw = parseFloat(ftSalaryInput.value);
        state.ftSalary = Number.isFinite(raw) ? raw : 0;
        schedule();
      });

      const ftInput = root.querySelector<HTMLInputElement>('[data-ft]');
      ftInput?.addEventListener('input', () => {
        const raw = parseFloat(ftInput.value);
        state.ft = Number.isFinite(raw) && raw > 0 ? raw : 1;
        schedule();
      });

      const actualInput = root.querySelector<HTMLInputElement>('[data-actual]');
      actualInput?.addEventListener('input', () => {
        const raw = parseFloat(actualInput.value);
        state.actual = Number.isFinite(raw) ? raw : 0;
        schedule();
      });

      const pensionSlider = root.querySelector<HTMLInputElement>('[data-pension]');
      const pensionValue = root.querySelector<HTMLElement>('[data-pension-value]');
      pensionSlider?.addEventListener('input', () => {
        const raw = parseFloat(pensionSlider.value);
        state.pension = Number.isFinite(raw) ? raw : 0;
        if (pensionValue) pensionValue.textContent = `${state.pension}%`;
        schedule();
      });

      const loanSelect = root.querySelector<HTMLSelectElement>('[data-loan]');
      loanSelect?.addEventListener('change', () => {
        state.loan = loanSelect.value as typeof state.loan;
        schedule();
      });

      root.querySelectorAll<HTMLButtonElement>('[data-region]').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.region = btn.dataset.region as 'rest-of-uk' | 'scotland';
          setToggle('data-region', state.region);
          schedule();
        });
      });

      recompute();

      // PDF download wiring
      const pdfBtn = root.querySelector<HTMLElement>('[data-download-pdf]');
      pdfBtn?.classList.remove('hidden');
      pdfBtn?.addEventListener('click', async () => {
        const { generateProRataPDF } = await import('../utils/pdfExport.js');
        const gross = (state.ftSalary / state.ft) * state.actual;
        const result = calculateTakeHomePay({ grossAnnualSalary: gross, pensionContributionPercent: state.pension, studentLoanPlan: state.loan, region: state.region, taxCode: '1257L' });
        const f = (n: number) => `\u00a3${Math.round(n).toLocaleString('en-GB')}`;
        generateProRataPDF({
          fullTimeSalary: f(state.ftSalary), fullTimeHours: String(state.ft), yourHours: String(state.actual), weeksPerYear: '52',
          annualGross: f(result.gross), annualTax: f(result.incomeTax), annualNI: f(result.nationalInsurance), annualNet: f(result.annualTakeHome),
          monthlyGross: f(result.gross / 12), monthlyTax: f(result.incomeTax / 12), monthlyNI: f(result.nationalInsurance / 12), monthlyNet: f(result.monthlyTakeHome),
          weeklyGross: f(result.gross / 52), weeklyTax: f(result.incomeTax / 52), weeklyNI: f(result.nationalInsurance / 52), weeklyNet: f(result.weeklyTakeHome),
          hourlyRate: f(gross / (state.ft * 52)), fullTimeSalaryRaw: state.ftSalary,
        });
      });
    });
  </script>
