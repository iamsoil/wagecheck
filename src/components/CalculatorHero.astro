---
interface Props {
  category: string;
  titleHtml: string;
  description: string;
  cta?: { href: string; label: string };
}

const { category, titleHtml, description, cta } = Astro.props;
---

<section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="text-center lg:text-left">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">{category}</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl" set:html={titleHtml} />
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg md:text-xl md:leading-8">
          {description}
        </p>
        {cta && (
          <a
            href={cta.href}
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-emerald-600 px-8 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
          >
            {cta.label} &rarr;
          </a>
        )}
      </div>
      <div class="relative hidden justify-center md:flex lg:justify-end lg:pr-12 xl:pr-20">
        <img
          src="/hero-glass.png"
          alt=""
          width="156"
          height="153"
          loading="eager"
          decoding="async"
          class="h-auto w-48 lg:w-56"
        />
      </div>
    </div>
  </div>
</section>
