---
interface Props {
  category: string;
  titleHtml: string;
  description: string;
  mobileDescription?: string;
  cta?: { href: string; label: string };
}

const { category, titleHtml, description, mobileDescription, cta } = Astro.props;
---

<section class="bg-gradient-to-br from-emerald-50 via-white to-lime-50">
  <div class="mx-auto max-w-7xl px-4 pt-8 pb-6 sm:px-6 md:pt-14 md:pb-10 lg:px-8 lg:pt-16 lg:pb-12">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="text-center lg:text-left">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-700 md:text-sm mb-2 md:mb-3">{category}</p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 mb-3 md:mb-5 lg:mb-6 md:text-4xl lg:text-5xl" set:html={titleHtml} />
        <p class="mx-auto max-w-xl text-sm text-slate-600 md:text-base lg:mx-0 mb-6 md:mb-8 lg:mb-10">
          {mobileDescription ? (
            <>
              <span class="hidden md:inline">{description}</span>
              <span class="md:hidden">{mobileDescription}</span>
            </>
          ) : (
            description
          )}
        </p>
        {cta && (
          <a
            href={cta.href}
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-emerald-600 px-8 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
          >
            {cta.label} &rarr;
          </a>
        )}
      </div>
      <div class="relative hidden justify-center md:flex lg:justify-end lg:pr-12 xl:pr-20">
        <img
          src="/hero-glass.png"
          alt=""
          width="156"
          height="153"
          loading="eager"
          decoding="async"
          class="h-auto w-44 lg:w-48"
        />
      </div>
    </div>
  </div>
</section>
