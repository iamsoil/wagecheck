---
import AnimatedNumber from './AnimatedNumber.astro';
import CalculatorInput from './CalculatorInput.astro';
import ShareResults from './ShareResults.astro';
import { calculateStampDuty, type StampDutyBuyerType, type StampDutyLocation } from '../lib/calculations';

type Props = {
  initialPropertyPrice?: number;
  initialLocation?: StampDutyLocation;
  initialBuyerType?: StampDutyBuyerType;
};

const {
  initialPropertyPrice = 300000,
  initialLocation = 'england',
  initialBuyerType = 'standard',
} = Astro.props as Props;

const gb = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });
const money = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;

const initialCalculation = calculateStampDuty(initialPropertyPrice, initialLocation, initialBuyerType);

const locationLabels: Record<StampDutyLocation, string> = {
  england: 'England & Northern Ireland',
  wales: 'Wales',
  scotland: 'Scotland',
};

const buyerTypeLabels: Record<StampDutyBuyerType, string> = {
  'first-time-buyer': 'First-time buyer',
  standard: 'Home mover',
  'buy-to-let': 'Buy-to-let / second home',
  'non-uk-resident': 'Non-UK resident',
};

const buyerOptions = [
  { value: 'standard', label: 'Home mover' },
  { value: 'first-time-buyer', label: 'First-time buyer' },
  { value: 'buy-to-let', label: 'Buy-to-let / second home' },
  { value: 'non-uk-resident', label: 'Non-UK resident' },
];

const inputClasses =
  'w-full rounded-xl border border-slate-200 bg-white px-3.5 py-2.5 text-sm font-medium text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100';
const toggleActive = 'bg-emerald-600 text-white';
const toggleInactive = 'text-slate-600 hover:text-emerald-600';

const barTotal = initialPropertyPrice + initialCalculation.total;
const pricePct = barTotal > 0 ? (initialPropertyPrice / barTotal) * 100 : 0;
const dutyPct = barTotal > 0 ? (initialCalculation.total / barTotal) * 100 : 0;

const initialShareRows = [
  { label: 'Property price', value: money(initialPropertyPrice) },
  { label: 'Location', value: locationLabels[initialLocation] },
  { label: 'Buyer type', value: buyerTypeLabels[initialBuyerType] },
  { label: 'Total stamp duty', value: money(initialCalculation.total) },
  { label: 'Effective rate', value: `${gb(initialCalculation.effectiveRate)}%` },
];

const initialStack = [
  { label: 'Stamp duty', value: initialCalculation.total, colorClass: 'bg-emerald-500' },
  { label: 'Purchase price', value: initialPropertyPrice, colorClass: 'bg-slate-300' },
];
---

<div id="stamp-duty-panel" data-stamp-duty-calculator data-initial-price={initialPropertyPrice} data-initial-location={initialLocation} data-initial-buyer={initialBuyerType}>
  <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm sm:p-8">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <CalculatorInput label="Property price (£)" hint="Enter the purchase price before any fees.">
          <input type="number" min="0" step="1000" value={initialPropertyPrice} data-price class={inputClasses} />
        </CalculatorInput>
      </div>

      <div class="sm:col-span-2">
        <span class="mb-1.5 block text-sm font-semibold text-slate-700">Location</span>
        <div class="inline-flex flex-wrap rounded-xl border border-slate-200 bg-white p-1">
          <button type="button" data-location="england" class:list={['rounded-lg px-4 py-2 text-sm font-semibold transition', initialLocation === 'england' ? toggleActive : toggleInactive]}>England &amp; NI</button>
          <button type="button" data-location="wales" class:list={['rounded-lg px-4 py-2 text-sm font-semibold transition', initialLocation === 'wales' ? toggleActive : toggleInactive]}>Wales</button>
          <button type="button" data-location="scotland" class:list={['rounded-lg px-4 py-2 text-sm font-semibold transition', initialLocation === 'scotland' ? toggleActive : toggleInactive]}>Scotland</button>
        </div>
      </div>

      <div class="sm:col-span-2">
        <CalculatorInput label="Buyer type">
          <select data-buyer class={inputClasses}>
            {buyerOptions.map((o) => <option value={o.value} selected={o.value === initialBuyerType}>{o.label}</option>)}
          </select>
        </CalculatorInput>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-teal-50 p-6">
        <p class="text-xs font-medium uppercase tracking-wider text-emerald-700">Total stamp duty</p>
        <div data-var="total" class="mt-2 block break-words">
          <AnimatedNumber value={initialCalculation.total} autoScale class="text-emerald-700" />
        </div>
        <p class="mt-2 text-sm text-slate-600">
          Effective rate: <span data-var="effectiveRate" class="font-semibold text-slate-900 tabular-nums">{gb(initialCalculation.effectiveRate)}%</span> of the purchase price
        </p>

        <div class="mt-6">
          <p class="text-sm font-semibold text-slate-900">Price vs duty</p>
          <div class="mt-3 flex h-4 w-full overflow-hidden rounded-full">
            <div data-var="barPrice" class="bg-slate-300" style={`width:${pricePct}%;`}></div>
            <div data-var="barDuty" class:list={['bg-emerald-500', initialCalculation.total === 0 && 'hidden']} style={`width:${dutyPct}%;`}></div>
          </div>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            <span class="flex items-center gap-1.5 text-xs text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>Purchase price · <span data-var="legPrice" class="tabular-nums">{money(initialPropertyPrice)} · {Math.round(pricePct)}%</span></span>
            <span class="flex items-center gap-1.5 text-xs text-slate-600"><span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>Stamp duty · <span data-var="legDuty" class="tabular-nums">{money(initialCalculation.total)} · {Math.round(dutyPct)}%</span></span>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <p class="border-b border-slate-100 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-900">Band breakdown</p>
        <div class="max-h-80 overflow-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                <th class="px-4 py-2.5">Band</th>
                <th class="px-4 py-2.5 text-right">Rate</th>
                <th class="px-4 py-2.5 text-right">Taxable</th>
                <th class="px-4 py-2.5 text-right">Tax</th>
              </tr>
            </thead>
            <tbody data-bands>
              {
                initialCalculation.bands.map((band) => (
                  <tr class="border-b border-slate-100 last:border-0">
                    <td class="px-4 py-2.5 font-medium text-slate-900">{band.label}</td>
                    <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">{Math.round(band.rate * 100)}%</td>
                    <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">{money(band.taxableAmount)}</td>
                    <td class="px-4 py-2.5 text-right font-medium tabular-nums text-slate-900">{money(band.tax)}</td>
                  </tr>
                ))
              }
              {
                initialCalculation.bands.length > 0 && (
                  <tr class="bg-emerald-50">
                    <td class="px-4 py-2.5 font-bold text-emerald-700">Total</td>
                    <td class="px-4 py-2.5"></td>
                    <td class="px-4 py-2.5 text-right tabular-nums text-emerald-700">{money(initialPropertyPrice)}</td>
                    <td data-cell="bandTotal" class="px-4 py-2.5 text-right font-bold tabular-nums text-emerald-700">{money(initialCalculation.total)}</td>
                  </tr>
                )
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="mt-6">
      <ShareResults
        product="Wagecheck Stamp Duty Calculator (2026/27)"
        rows={initialShareRows}
        markdownHeaders={['Item', 'Value']}
        markdownRows={initialShareRows}
        modalTitle="Your stamp duty bill"
        modalValue={money(initialCalculation.total)}
        modalSub={`For a ${money(initialPropertyPrice)} property in ${locationLabels[initialLocation]}`}
        stack={initialStack}
        source="#stamp-duty-panel"
      />
    </div>

    <button
      data-download-pdf
      class="hidden mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-emerald-200 text-emerald-700 font-medium rounded-xl hover:bg-emerald-50 hover:border-emerald-300 transition-all duration-200 shadow-sm"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Download PDF Report
    </button>

    <p class="mt-4 text-xs leading-5 text-slate-400">Based on 2026/27 rates. Verify with HMRC before completing your purchase.</p>
  </div>
</div>

<script>
  import { calculateStampDuty } from '../lib/calculations';

  const gb = (n: number) => n.toLocaleString('en-GB', { maximumFractionDigits: 2 });
  const money = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;

  const locationLabels: Record<string, string> = {
    england: 'England & Northern Ireland',
    wales: 'Wales',
    scotland: 'Scotland',
  };

  const buyerTypeLabels: Record<string, string> = {
    'first-time-buyer': 'First-time buyer',
    standard: 'Home mover',
    'buy-to-let': 'Buy-to-let / second home',
    'non-uk-resident': 'Non-UK resident',
  };

  document.querySelectorAll<HTMLElement>('[data-stamp-duty-calculator]').forEach((root) => {
    const state = {
      price: parseFloat(root.dataset.initialPrice || '300000'),
      location: (root.dataset.initialLocation || 'england') as 'england' | 'wales' | 'scotland',
      buyer: (root.dataset.initialBuyer || 'standard') as 'first-time-buyer' | 'standard' | 'buy-to-let' | 'non-uk-resident',
    };

    function setNum(panel: HTMLElement, key: string, value: number) {
      const wrapper = panel.querySelector<HTMLElement>(`[data-var="${key}"]`);
      const el = wrapper?.querySelector<HTMLElement>('[data-animated-number]');
      if (el) {
        el.dataset.animatedNumber = String(value);
      }
    }

    function setToggle(panel: HTMLElement, attribute: string, value: string) {
      panel.querySelectorAll<HTMLButtonElement>(`[${attribute}]`).forEach((btn) => {
        const isActive = btn.getAttribute(attribute) === value;
        btn.classList.toggle('bg-emerald-600', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('text-slate-600', !isActive);
        btn.classList.toggle('hover:text-emerald-600', !isActive);
      });
    }

    function render(panel: HTMLElement, result: ReturnType<typeof calculateStampDuty>) {
      setNum(panel, 'total', result.total);

      const rateEl = panel.querySelector<HTMLElement>('[data-var="effectiveRate"]');
      if (rateEl) rateEl.textContent = `${gb(result.effectiveRate)}%`;

      const totalBar = state.price + result.total;
      const pricePct = totalBar > 0 ? (state.price / totalBar) * 100 : 0;
      const dutyPct = totalBar > 0 ? (result.total / totalBar) * 100 : 0;

      const barPrice = panel.querySelector<HTMLElement>('[data-var="barPrice"]');
      if (barPrice) barPrice.style.width = `${pricePct}%`;
      const barDuty = panel.querySelector<HTMLElement>('[data-var="barDuty"]');
      if (barDuty) {
        barDuty.style.width = `${dutyPct}%`;
        barDuty.classList.toggle('hidden', result.total === 0);
      }

      const legPrice = panel.querySelector<HTMLElement>('[data-var="legPrice"]');
      if (legPrice) legPrice.textContent = `${money(state.price)} · ${Math.round(pricePct)}%`;
      const legDuty = panel.querySelector<HTMLElement>('[data-var="legDuty"]');
      if (legDuty) legDuty.textContent = `${money(result.total)} · ${Math.round(dutyPct)}%`;

      const tbody = panel.querySelector<HTMLElement>('[data-bands]');
      if (tbody) {
        const rows = result.bands
          .map(
            (band) =>
              `<tr class="border-b border-slate-100 last:border-0">
                <td class="px-4 py-2.5 font-medium text-slate-900">${band.label}</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">${Math.round(band.rate * 100)}%</td>
                <td class="px-4 py-2.5 text-right tabular-nums text-slate-600">${money(band.taxableAmount)}</td>
                <td class="px-4 py-2.5 text-right font-medium tabular-nums text-slate-900">${money(band.tax)}</td>
              </tr>`
          )
          .join('');
        const totalRow = `<tr class="bg-emerald-50">
          <td class="px-4 py-2.5 font-bold text-emerald-700">Total</td>
          <td class="px-4 py-2.5"></td>
          <td class="px-4 py-2.5 text-right tabular-nums text-emerald-700">${money(state.price)}</td>
          <td class="px-4 py-2.5 text-right font-bold tabular-nums text-emerald-700">${money(result.total)}</td>
        </tr>`;
        tbody.innerHTML = rows + totalRow;
      }

      const rows = [
        { label: 'Property price', value: money(state.price) },
        { label: 'Location', value: locationLabels[state.location] },
        { label: 'Buyer type', value: buyerTypeLabels[state.buyer] },
        { label: 'Total stamp duty', value: money(result.total) },
        { label: 'Effective rate', value: `${gb(result.effectiveRate)}%` },
      ];
      const stack = [
        { label: 'Stamp duty', value: result.total, colorClass: 'bg-emerald-500' },
        { label: 'Purchase price', value: state.price, colorClass: 'bg-slate-300' },
      ];

      panel.dataset.sharePayload = JSON.stringify({
        product: 'Wagecheck Stamp Duty Calculator (2026/27)',
        rows,
        markdown: { headers: ['Item', 'Value'], rows },
        modal: {
          title: 'Your stamp duty bill',
          value: money(result.total),
          sub: `For a ${money(state.price)} property in ${locationLabels[state.location]}`,
          stack,
        },
      });

      const card = panel.querySelector<HTMLElement>('[data-share-card]');
      if (card) {
        const title = card.querySelector<HTMLElement>('[data-share-title]');
        const value = card.querySelector<HTMLElement>('[data-share-value]');
        const sub = card.querySelector<HTMLElement>('[data-share-sub]');
        const stackEl = card.querySelector<HTMLElement>('[data-share-stack]');
        if (title) title.textContent = 'Your stamp duty bill';
        if (value) value.textContent = money(result.total);
        if (sub) sub.textContent = `For a ${money(state.price)} property in ${locationLabels[state.location]}`;
        if (stackEl) {
          const total = stack.reduce((sum, s) => sum + s.value, 0);
          const bar = stack
            .map(
              (s) =>
                `<div style="width:${total > 0 ? (s.value / total) * 100 : 0}%" class="${s.colorClass} ${s.value === 0 ? 'hidden' : ''}"></div>`
            )
            .join('');
          const legend = stack
            .map(
              (s) =>
                `<span class="flex items-center gap-1.5 text-xs text-slate-600"><span class="h-2.5 w-2.5 rounded-full ${s.colorClass}"></span>${s.label} · ${
                  total > 0 ? Math.round((s.value / total) * 100) : 0
                }%</span>`
            )
            .join('');
          stackEl.innerHTML = `<div class="flex h-4 w-full overflow-hidden rounded-full">${bar}</div><div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">${legend}</div>`;
        }
      }
    }

    function recompute() {
      const result = calculateStampDuty(state.price, state.location, state.buyer);
      render(root, result);
    }

    let timer = 0;
    function schedule() {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => recompute(), 150);
    }

    const priceInput = root.querySelector<HTMLInputElement>('[data-price]');
    priceInput?.addEventListener('input', () => {
      const raw = parseFloat(priceInput.value);
      state.price = Number.isFinite(raw) ? raw : 0;
      schedule();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-location]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.location = btn.dataset.location as typeof state.location;
        setToggle(root, 'data-location', state.location);
        schedule();
      });
    });

    const buyerSelect = root.querySelector<HTMLSelectElement>('[data-buyer]');
    buyerSelect?.addEventListener('change', () => {
      state.buyer = buyerSelect.value as typeof state.buyer;
      schedule();
    });

    recompute();

    // PDF download wiring
    const pdfBtn = root.querySelector<HTMLElement>('[data-download-pdf]');
    pdfBtn?.classList.remove('hidden');
    pdfBtn?.addEventListener('click', async () => {
      const { generateStampDutyPDF } = await import('../utils/pdfExport.js');
      const r = calculateStampDuty(state.price, state.location, state.buyer);
      const locationLabels: Record<string, string> = { england: 'England & Northern Ireland', wales: 'Wales', scotland: 'Scotland' };
      const buyerLabels: Record<string, string> = { 'first-time-buyer': 'First-time buyer', standard: 'Home mover', 'buy-to-let': 'Buy-to-let / second home', 'non-uk-resident': 'Non-UK resident' };
      generateStampDutyPDF({
        propertyPrice: `£${Math.round(state.price).toLocaleString('en-GB')}`, propertyPriceRaw: state.price,
        buyerType: buyerLabels[state.buyer] || state.buyer,
        location: locationLabels[state.location] || state.location,
        bands: r.bands.map((b: any) => ({ band: b.band || `${b.from.toLocaleString('en-GB')} - ${b.to === Infinity ? 'above' : b.to.toLocaleString('en-GB')}`, rate: b.rate + '%', taxable: `£${Math.round(b.taxableAmount).toLocaleString('en-GB')}`, tax: `£${Math.round(b.tax).toLocaleString('en-GB')}` })),
        totalTax: `£${Math.round(r.total).toLocaleString('en-GB')}`,
      });
    });
  });
</script>
