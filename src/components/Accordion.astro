---
type Props = {
  title: string;
};

const { title } = Astro.props as Props;
---

<details class="group rounded-2xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-sm">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left [&::-webkit-details-marker]:hidden">
    <span class="text-base font-semibold text-slate-900">{title}</span>
    <svg
      class="h-5 w-5 shrink-0 text-emerald-600 transition-transform duration-200 group-open:rotate-180"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <div class="mt-3 text-sm leading-6 text-slate-600">
    <slot />
  </div>
</details>
