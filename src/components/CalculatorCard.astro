---
import Icon from './Icon.astro';

type Props = {
  title: string;
  description: string;
  href: string;
  iconName: 'calculator' | 'document' | 'home';
  badge?: string;
};

const { title, description, href, iconName, badge } = Astro.props as Props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-2xl border border-slate-100 border-l-4 border-l-emerald-500 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
>
  <div class="flex items-center justify-between">
    <Icon name={iconName} class="h-6 w-6 text-emerald-600" />
    {badge && <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-700">{badge}</span>}
  </div>
  <h3 class="mt-5 text-lg font-semibold text-slate-900">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{description}</p>
  <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 transition-colors group-hover:text-emerald-700">
    Learn more
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3" />
    </svg>
  </span>
</a>
