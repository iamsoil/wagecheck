<---
import Icon from './Icon.astro';
type Props = {
  title: string;
  description: string;
  href: string;
  iconName: 'calculator' | 'document' | 'home';
  badge?: string;
};
const { title, description, href, iconName, badge } = Astro.props as Props;
--->
<div class="bg-white rounded-2xl shadow-sm border-l-4 border-emerald-500 hover:shadow-lg transition-shadow duration-300">
  <div class="flex items-center p-4">
    <Icon name={iconName} class="h-6 w-6 text-emerald-600" />
    <div class="ml-3">
      <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
      <p class="text-gray-600">{description}</p>
      {badge && <p class="text-sm text-yellow-600 font-medium">{badge}</p>}
    </div>
  </div>
  <a href={href} class="mt-4 inline-block bg-emerald-600 text-white px-6 py-2 rounded-xl hover:bg-emerald-700 transition-colors">Learn More</a>
</div>