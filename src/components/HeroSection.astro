---
---
<section class="relative bg-gradient-to-b from-emerald-50/50 to-white overflow-hidden">
  <div class="mx-auto px-4 py-3.5 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="text-center lg:text-left">
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-600">Salary calculator</p>
        <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Know exactly what you take home
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-base text-slate-500 sm:text-lg lg:mx-0">
          Free UK salary, tax and stamp duty calculators. No signup, no spam — just accurate numbers.
        </p>
        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row lg:justify-start">
          <a
            href="/salary-calculator"
            class="cta-pulse inline-flex items-center justify-center rounded-xl bg-emerald-600 px-8 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
          >
            Salary Calculator
          </a>
          <a
            href="/stamp-duty-calculator"
            class="inline-flex items-center justify-center rounded-xl border border-emerald-200 bg-white px-8 py-3.5 text-sm font-semibold text-emerald-700 shadow-sm transition hover:border-emerald-300 hover:bg-emerald-50"
          >
            Stamp Duty Calculator
          </a>
        </div>
      </div>
      <div class="relative hidden items-center justify-center md:flex">
        <img
          src="/calculator-glass.png"
          alt=""
          width="480"
          height="480"
          loading="eager"
          decoding="async"
          class="h-auto w-full max-w-[307px] lg:max-w-[358px]"
        />
      </div>
    </div>
  </div>
</section>
