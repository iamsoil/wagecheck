---
type Props = {
  title?: string;
  description?: string;
  cards: {
    icon: string;
    heading: string;
    description: string;
    ctaText: string;
    href: string;
    rel?: string;
    sponsored?: boolean;
  }[];
};

function deriveCategory(href: string): string {
  try {
    const url = new URL(href);
    const path = url.pathname;
    if (path.includes('/savings/')) return 'savings';
    if (path.includes('/credit-cards/')) return 'credit-cards';
    if (path.includes('/isas/') || path.includes('/isa/')) return 'isas';
    if (path.includes('/mortgages/')) return 'mortgages';
    if (path.includes('/accounting/')) return 'accounting';
    if (path.includes('/business-bank-accounts/')) return 'business-banking';
    if (path.includes('/pensions/')) return 'pensions';
    if (path.includes('/conveyancing/')) return 'conveyancing';
    if (path.includes('/landlord-insurance/')) return 'landlord-insurance';
    if (path.includes('/buy-to-let/')) return 'buy-to-let-mortgages';
    return 'affiliate';
  } catch {
    return 'affiliate';
  }
}

const { title = 'Next steps', description = '', cards } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-12 md:py-16 sm:px-6 lg:px-8">
<div class="rounded-3xl border border-emerald-200 bg-emerald-50/40 p-6 sm:p-8">
  <h2 class="text-xl font-bold tracking-tight text-slate-900">{title}</h2>
  {description && <p class="mt-2 text-sm text-slate-600">{description}</p>}

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => {
        const category = deriveCategory(card.href);
        return (
        <a
          href={card.href}
          target="_blank"
          rel={card.rel ?? 'noopener'}
          data-affiliate-category={category}
          data-affiliate-heading={card.heading}
          class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-emerald-200 hover:shadow-md"
        >
          <div class="flex items-center gap-2.5 text-emerald-600">
            <span class="text-xl" aria-hidden="true">{card.icon}</span>
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Sponsored</span>
          </div>
          <h3 class="mt-3 text-base font-semibold text-slate-900 group-hover:text-emerald-700">{card.heading}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{card.description}</p>
          <p class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-emerald-700 group-hover:text-emerald-800">
            {card.ctaText}
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </p>
        </a>
        );
      })}
    </div>

    {cards.some(card => card.sponsored) && (
      <p class="mt-4 text-xs leading-5 text-slate-500">
        Some links below are <span class="font-medium">sponsored</span> — wagecheck may earn a commission if you take out a product through them, at no extra cost to you. This helps keep the calculators free.
      </p>
    )}
  </div>
</section>

<script is:inline>
  (function() {
    document.addEventListener('click', function(e) {
      var el = e.target.closest('a[data-affiliate-category]');
      if (!el || el.target !== '_blank') return;
      var cat = el.getAttribute('data-affiliate-category') || 'affiliate';
      var heading = el.getAttribute('data-affiliate-heading') || '';
      if (typeof window !== 'undefined' && window.dataLayer) {
        window.dataLayer.push({
          event: 'affiliate_click',
          affiliate_category: cat,
          affiliate_heading: heading,
          affiliate_outbound: true,
        });
      }
    });
  })();
</script>
