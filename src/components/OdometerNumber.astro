---
type Props = {
  value: number;
  prefix?: string;
  duration?: number;
  class?: string;
  id?: string;
};

const {
  value,
  prefix = '£',
  duration = 1000,
  class: className = '',
  id,
} = Astro.props as Props;

const rootId = id || `odometer-${Math.random().toString(36).slice(2, 10)}`;
const formatter = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 });
const initialValue = Number.isFinite(value) ? Math.round(value) : 0;
const initialFormatted = formatter.format(Math.abs(initialValue));
---

<span
  id={rootId}
  data-odometer-root="true"
  data-value={initialValue}
  data-duration={duration}
  data-prefix={prefix}
  class={`inline-flex items-baseline gap-0.5 tabular-nums leading-none ${className}`.trim()}
>
  {prefix ? <span class="shrink-0">{prefix}</span> : null}
  <span data-odometer-track class="inline-flex items-baseline" aria-hidden="true">
    {initialFormatted.split('').map((character) =>
      character === ',' ? (
        <span class="inline-block w-[0.3em] text-center">,</span>
      ) : (
        <span class="inline-block h-[1em] w-[0.72em] overflow-hidden align-baseline">
          <span data-odometer-strip style={`transform: translateY(calc(-${Number(character)} * 1em)); transition: transform ${duration}ms cubic-bezier(0.4, 0, 0.2, 1); will-change: transform;`}>
            {Array.from({ length: 10 }, (_, index) => (
              <span class="block h-[1em] leading-[1em] text-center">
                {index}
              </span>
            ))}
          </span>
        </span>
      ),
    )}
  </span>
  <span class="sr-only">{prefix}{initialFormatted}</span>
</span>

<script define:vars={{ rootId }}>
  const root = document.getElementById(rootId);
  if (root) {
    const track = root.querySelector('[data-odometer-track]');
    const formatter = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 });
    const duration = Number(root.dataset.duration || '1000');
    const easing = 'cubic-bezier(0.4, 0, 0.2, 1)';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function buildDigitStrip(digit) {
      const strip = document.createElement('span');
      strip.setAttribute('data-odometer-strip', 'true');
      strip.style.display = 'inline-flex';
      strip.style.flexDirection = 'column';
      strip.style.willChange = 'transform';
      strip.style.transition = `transform ${duration}ms ${easing}`;
      strip.style.transform = `translateY(calc(-${digit} * 1em))`;

      for (let index = 0; index < 10; index += 1) {
        const digitNode = document.createElement('span');
        digitNode.textContent = String(index);
        digitNode.style.display = 'block';
        digitNode.style.height = '1em';
        digitNode.style.lineHeight = '1em';
        digitNode.style.textAlign = 'center';
        strip.appendChild(digitNode);
      }

      return strip;
    }

    function buildDigitColumn(character) {
      const column = document.createElement('span');
      column.style.display = 'inline-block';
      column.style.height = '1em';
      column.style.width = '0.72em';
      column.style.overflow = 'hidden';
      column.style.verticalAlign = 'baseline';
      column.appendChild(buildDigitStrip(Number(character)));
      return column;
    }

    function renderValue(nextValue, animate = true) {
      if (!track) {
        return;
      }

      const formatted = formatter.format(Math.abs(Math.round(nextValue)));
      const nextCharacters = formatted.split('');
      const currentColumns = Array.from(track.children);

      if (currentColumns.length !== nextCharacters.length) {
        track.innerHTML = '';

        nextCharacters.forEach((character) => {
          if (character === ',') {
            const separator = document.createElement('span');
            separator.textContent = ',';
            separator.style.display = 'inline-block';
            separator.style.width = '0.3em';
            separator.style.textAlign = 'center';
            track.appendChild(separator);
            return;
          }

          track.appendChild(buildDigitColumn(character));
        });

        root.dataset.currentValue = String(Math.round(nextValue));
        return;
      }

      nextCharacters.forEach((character, index) => {
        const column = currentColumns[index];

        if (!column) {
          return;
        }

        if (character === ',') {
          column.textContent = ',';
          return;
        }

        const strip = column.querySelector('[data-odometer-strip]');
        if (!strip) {
          return;
        }

        if (!animate || reduceMotion) {
          strip.style.transition = 'none';
        } else {
          strip.style.transition = `transform ${duration}ms ${easing}`;
        }

        requestAnimationFrame(() => {
          strip.style.transform = `translateY(calc(-${Number(character)} * 1em))`;
        });
      });

      root.dataset.currentValue = String(Math.round(nextValue));
    }

    renderValue(Number(root.dataset.value || '0'), false);

    const observer = new MutationObserver((mutations) => {
      if (mutations.some((mutation) => mutation.type === 'attributes' && mutation.attributeName === 'data-value')) {
        renderValue(Number(root.dataset.value || '0'));
      }
    });

    observer.observe(root, { attributes: true, attributeFilter: ['data-value'] });
  }
</script>