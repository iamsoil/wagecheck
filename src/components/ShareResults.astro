---
export type ShareRow = {
  label: string;
  value: string;
};

type StackSegment = {
  label: string;
  value: number;
  colorClass: string;
};

type Props = {
  product: string;
  rows: ShareRow[];
  markdownHeaders?: string[];
  markdownRows?: ShareRow[];
  modalTitle: string;
  modalValue: string;
  modalSub?: string;
  stack?: StackSegment[];
  source?: string;
};

const {
  product,
  rows,
  markdownHeaders = ['Field', 'Value'],
  markdownRows = rows,
  modalTitle,
  modalValue,
  modalSub,
  stack = [],
  source,
} = Astro.props as Props;

const id = `share-modal-${crypto.randomUUID()}`;

const rowsJson = JSON.stringify(rows);
const mdJson = JSON.stringify({ headers: markdownHeaders, rows: markdownRows });
const stackJson = JSON.stringify(stack);

const stackTotal = stack.reduce((sum, seg) => sum + seg.value, 0);
---

<div
  data-share-root
  data-rows={rowsJson}
  data-markdown={mdJson}
  data-product={product}
  data-modal-title={modalTitle}
  data-modal-value={modalValue}
  data-modal-sub={modalSub}
  data-modal-stack={stackJson}
  data-source={source}
>
  <input id={id} type="checkbox" class="peer sr-only" />

  <div class="flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-share-copy-text
      class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="8" y="2" width="8" height="4" rx="1" />
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
      </svg>
      Copy as Text
    </button>
    <button
      type="button"
      data-share-copy-markdown
      class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:text-emerald-700"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <path d="M14 2v6h6" />
        <path d="M9 13h6M9 17h6" />
      </svg>
      Copy as Markdown
    </button>
    <label
      for={id}
      class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:text-emerald-700"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
      View Summary
    </label>
    <button
      type="button"
      data-share-copy-image
      class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:text-emerald-700"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="m21 15-5-5L5 21" />
      </svg>
      Copy Image
    </button>
  </div>

  <div class="fixed inset-0 z-[60] hidden peer-checked:block" role="dialog" aria-modal="true">
    <label for={id} class="absolute inset-0 cursor-pointer bg-slate-900/60"></label>
    <div class="pointer-events-none relative flex h-full items-center justify-center p-4">
      <div
        data-share-card
        class="pointer-events-auto w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-2xl"
      >
        <div class="bg-gradient-to-br from-emerald-600 to-teal-600 px-6 py-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-100">{product}</p>
              <h3 data-share-title class="mt-2 text-lg font-bold text-white">{modalTitle}</h3>
            </div>
            <label for={id} class="shrink-0 cursor-pointer rounded-full bg-white/10 p-2 text-white transition hover:bg-white/20">
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
            </label>
          </div>
        </div>

        <div class="px-6 py-6">
          <p data-share-value class="text-4xl font-bold tabular-nums text-emerald-600">{modalValue}</p>
          <p data-share-sub class="mt-1 text-sm text-slate-500">{modalSub}</p>

          <div data-share-stack class="mt-6">
            {stack.length > 0 && (
              <>
                <div class="flex h-4 w-full overflow-hidden rounded-full">
                  {stack.map((seg) => (
                    <div
                      class:list={[seg.colorClass, seg.value === 0 && 'hidden']}
                      style={`width:${stackTotal > 0 ? (seg.value / stackTotal) * 100 : 0}%;`}
                    ></div>
                  ))}
                </div>
                <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
                  {stack.map((seg) => (
                    <span class="flex items-center gap-1.5 text-xs text-slate-600">
                      <span class:list={['h-2.5 w-2.5 rounded-full', seg.colorClass]}></span>
                      {seg.label} · {stackTotal > 0 ? Math.round((seg.value / stackTotal) * 100) : 0}%
                    </span>
                  ))}
                </div>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function showToast(message: string) {
    let toast = document.querySelector<HTMLDivElement>('.share-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.className =
        'share-toast fixed bottom-6 left-1/2 z-[70] -translate-x-1/2 rounded-full bg-slate-900 px-4 py-2 text-sm font-medium text-white shadow-lg transition-opacity duration-200';
      document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.style.opacity = '1';
    clearTimeout((showToast as any)._timer);
    (showToast as any)._timer = window.setTimeout(() => {
      toast!.style.opacity = '0';
    }, 2000);
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
    }
  }

  function buildText(payload: any) {
    const product = payload.product;
    const divider = '='.repeat(product.length);
    const lines = [
      product,
      divider,
      '',
      ...payload.rows.map((r: any) => `${r.label}: ${r.value}`),
      '',
      'Generated with wagecheck.co.uk',
    ];
    return lines.join('\n');
  }

  function buildMarkdown(payload: any) {
    const md = payload.markdown;
    const headerRow = `| ${md.headers.join(' | ')} |`;
    const dividerRow = `| ${md.headers.map(() => '---').join(' | ')} |`;
    const bodyRows = md.rows.map((r: any) => `| ${r.label} | ${r.value} |`);
    return [`### ${payload.product}`, '', headerRow, dividerRow, ...bodyRows].join('\n');
  }

  document.querySelectorAll<HTMLElement>('[data-share-root]').forEach((root) => {
    const sourceSelector = root.dataset.source;

    function readPayload() {
      if (sourceSelector) {
        const el = document.querySelector<HTMLElement>(sourceSelector);
        if (el?.dataset.sharePayload) {
          return JSON.parse(el.dataset.sharePayload);
        }
      }
      return {
        product: root.dataset.product ?? 'wagecheck',
        rows: JSON.parse(root.dataset.rows ?? '[]'),
        markdown: JSON.parse(root.dataset.markdown ?? '{"headers":["Field","Value"],"rows":[]}'),
        modal: {
          title: root.dataset.modalTitle,
          value: root.dataset.modalValue,
          sub: root.dataset.modalSub,
          stack: JSON.parse(root.dataset.modalStack ?? '[]'),
        },
      };
    }

    const card = root.querySelector<HTMLElement>('[data-share-card]');

    root.querySelector<HTMLButtonElement>('[data-share-copy-text]')?.addEventListener('click', async () => {
      await copyText(buildText(readPayload()));
      showToast('Copied to clipboard!');
    });

    root.querySelector<HTMLButtonElement>('[data-share-copy-markdown]')?.addEventListener('click', async () => {
      await copyText(buildMarkdown(readPayload()));
      showToast('Copied to clipboard!');
    });

    root.querySelector<HTMLButtonElement>('[data-share-copy-image]')?.addEventListener('click', async () => {
      const lib = (window as any).html2canvas;
      if (lib && card) {
        try {
          const canvas = await lib(card, { backgroundColor: '#ffffff', scale: 2 });
          const blob: Blob | null = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
          if (blob) {
            await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
            showToast('Copied image to clipboard!');
            return;
          }
        } catch {
          // fall through to text fallback
        }
      }
      await copyText(buildText(readPayload()));
      showToast('Copied summary to clipboard!');
    });
  });
</script>
